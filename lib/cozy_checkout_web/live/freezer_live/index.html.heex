<Layouts.app
  flash={@flash}
  food_section={:freezer}
  food_context={@food_context}
  show_header={false}
>
  <.kitchen_header
    title="Mrazák"
    subtitle="Aktuální sdílená evidence. Zásoby jsou informativní; nákupní množství se nemění."
  >
    <:actions><.button phx-click="new" id="new-freezer-item">Přidat položku</.button></:actions>
  </.kitchen_header>
  <.form
    for={to_form(%{"search" => @search, "archived" => to_string(@archived)}, as: :filter)}
    id="freezer-filter"
    phx-change="filter"
    class="mb-6 grid gap-3 sm:grid-cols-2"
  >
    <.input
      name="filter[search]"
      value={@search}
      label="Hledat podle názvu"
      type="search"
      phx-debounce="200"
    />
    <.input
      name="filter[archived]"
      value={to_string(@archived)}
      type="select"
      label="Stav"
      options={[{"Aktivní", "false"}, {"Vyřazené", "true"}]}
    />
  </.form>
  <p :if={@items == []} id="freezer-empty">
    Žádné položky. Přidejte první zásobu nebo změňte filtr.
  </p>
  <article
    :for={item <- @items}
    id={"freezer-item-#{item.id}"}
    class="mb-3 rounded-lg border border-secondary-200 bg-white p-4"
  >
    <h2 class="font-semibold">
      {item.name} · {Recipes.format_quantity(item.quantity, item.unit)}
    </h2>
    <p>
      Zamrazeno {Calendar.strftime(item.frozen_on, "%d. %m. %Y")} · {Date.diff(
        Freezer.today(),
        item.frozen_on
      )} dní · {item.location}
    </p>
    <p :if={item.ingredient}>
      Surovina: {item.ingredient.name} {if item.ingredient.archived_at, do: "(archivováno)"}
    </p>
    <p :if={item.recipe}>
      Recept: {item.recipe.name} {if item.recipe.archived_at, do: "(archivováno)"}
    </p>
    <p :if={is_nil(item.recipe_id) && is_nil(item.ingredient_id)}>Bez propojení</p>
    <p class="whitespace-pre-line">{item.notes}</p>
    <div :if={!@archived} class="mt-3 flex flex-wrap gap-4">
      <.button phx-click="edit" phx-value-id={item.id}>Upravit</.button>
      <.button phx-click="remove" phx-value-id={item.id}>Odebrat</.button>
      <.button
        phx-click="archive"
        phx-value-id={item.id}
        data-confirm="Vyřadit položku z evidence?"
      >Vyřadit</.button>
    </div>
  </article>
  <.modal :if={@editing} id="freezer-edit" show on_cancel={JS.push("close")}>
    <h2 class="mb-4 text-xl font-semibold">
      {if @editing.id, do: "Upravit zásobu", else: "Přidat zásobu"}
    </h2>
    <.form for={@form} id="freezer-form" phx-change="validate" phx-submit="save" class="space-y-3">
      <.searchable_picker
        field={to_form(%{"link" => current_link(@form, @editing)}, as: :freezer_item)[:link]}
        options={link_options(@ingredients, @recipes, @editing)}
        query={@link_query}
        open={@link_search_open}
        required={false}
        focus_id={@form[:quantity].id}
        label="Propojení"
        prompt="Bez propojení"
        placeholder="Hledat surovinu nebo hotové jídlo…"
        search_name="link_search"
        search_event="search_links"
        open_event="open_link_search"
        close_event="close_link_search"
        select_event="select_link"
        error_message={link_error(@form)}
      />
      <button type="button" phx-click="clear_link" class="text-sm text-tertiary-600 underline">Bez propojení</button>
      <.input field={@form[:name]} label="Název" required />
      <.input
        field={@form[:quantity]}
        label="Množství"
        type="number"
        step="any"
        min="0"
        required
      />
      <.input
        field={@form[:unit]}
        label="Jednotka"
        type="select"
        options={~w(kg g l ml ks porce)}
      />
      <.input field={@form[:frozen_on]} label="Datum zamrazení" type="date" required />
      <.input field={@form[:location]} label="Umístění" />
      <.input field={@form[:notes]} label="Poznámka" type="textarea" />
      <.button type="submit" phx-disable-with="Ukládám…">Uložit</.button>
    </.form>
  </.modal>
  <.modal :if={@removing} id="freezer-remove" show on_cancel={JS.push("close")}>
    <h2 class="mb-4 text-xl font-semibold">Odebrat · {@removing.name}</h2>
    <p>K dispozici: {Recipes.format_quantity(@removing.quantity, @removing.unit)}</p>
    <.form for={to_form(%{})} id="freezer-remove-form" phx-submit="take">
      <.input
        name="amount"
        value=""
        type="number"
        step="any"
        min="0"
        label={"Odebrat (#{@removing.unit})"}
        required
      />
      <.button type="submit">Odebrat část</.button>
      <.button type="button" phx-click="all">Vše</.button>
    </.form>
  </.modal>
</Layouts.app>
