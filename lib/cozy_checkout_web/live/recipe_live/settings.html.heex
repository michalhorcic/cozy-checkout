<Layouts.app
  flash={@flash}
  food_section={:settings}
  food_context={@food_context}
  show_header={false}
>
  <.kitchen_header
    title="Nastavení porcí"
    subtitle="Velikost dětské porce při výpočtu surovin pro všechna menu."
  />
  <section class="max-w-2xl rounded-lg border border-secondary-200 bg-white p-5 shadow-sm sm:p-6">
    <h2 class="text-xl font-bold text-primary-500">Jak velká je dětská porce?</h2>
    <p class="mb-6 mt-3 text-sm leading-relaxed text-primary-400">
      Hodnoty platí pro přepočet surovin. Počet porcí pro výdej zůstává stejný. Výchozí hodnota z podkladové tabulky je 70 %.
    </p>
    <.form for={@form} id="portion-settings-form" phx-submit="save" class="space-y-4">
      <.input
        field={@form[:hot]}
        type="number"
        min="0"
        max="100"
        step="any"
        label="Obědy a večeře (%)"
        class={field_class()}
        required
      />
      <.input
        field={@form[:breakfast]}
        type="number"
        min="0"
        max="100"
        step="any"
        label="Snídaně a bufet (%)"
        class={field_class()}
        required
      />
      <p :if={@error} id="portion-settings-error" role="alert" class="text-sm text-red-700">
        {@error}
      </p>
      <button
        type="submit"
        phx-disable-with="Ukládám…"
        class="rounded-lg bg-primary-500 px-5 py-2.5 text-sm font-semibold text-white hover:bg-primary-600"
      >Uložit nastavení</button>
    </.form>
  </section>
</Layouts.app>
