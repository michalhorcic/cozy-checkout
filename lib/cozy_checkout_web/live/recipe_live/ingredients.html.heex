<Layouts.app
  food_section={:ingredients}
  food_context={@food_context}
  flash={@flash}
  show_header={false}
  main_class=""
  content_class=""
>
  <div class="food-page">
    <div class="w-full">
      <.kitchen_header
        title="Suroviny"
        subtitle="Jeden katalog pro všechny recepty. Přehledné jednotky a poznámky pro kuchyň."
      >
        <:actions>
          <.link navigate={~p"/admin/kitchen-costs/prices"} class="text-tertiary-700">Ceny a historie nákupů</.link>
          <.link
            id="new-ingredient"
            patch={
              CozyCheckoutWeb.FoodNavigation.with_context(
                ~p"/admin/ingredients/new",
                @food_context
              )
            }
            class="inline-flex items-center gap-2 rounded-lg bg-primary-500 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-primary-600"
          ><.icon name="hero-plus" class="h-4 w-4" />Nová surovina</.link>
        </:actions>
      </.kitchen_header>
      <.form
        for={%{}}
        id="ingredient-search-form"
        phx-change="search"
        class="mb-6 flex flex-wrap items-center justify-between gap-4"
      >
        <div class="relative w-full max-w-xl">
          <.icon
            name="hero-magnifying-glass"
            class="pointer-events-none absolute left-4 top-3.5 h-5 w-5 text-primary-300"
          /><input
            id="ingredient-search"
            type="search"
            name="search"
            value={@search}
            phx-debounce="200"
            placeholder="Hledat surovinu nebo kategorii…"
            aria-label="Hledat surovinu"
            class="w-full rounded-lg border border-secondary-200 bg-white py-3 pl-12 pr-4 text-sm outline-none focus:border-tertiary-400 focus:ring-4 focus:ring-tertiary-50"
          />
        </div><span id="ingredient-count" class="text-sm text-primary-400">{@result_count} surovin</span>
      </.form>
      <section class="overflow-hidden rounded-lg border border-secondary-200 bg-white shadow-sm">
        <div class="grid grid-cols-[1fr_6rem_3rem] gap-4 border-b border-secondary-200 bg-secondary-50 px-5 py-3 text-xs font-semibold uppercase tracking-wide text-primary-400 sm:grid-cols-[1fr_12rem_6rem_4rem]">
          <span>Surovina</span><span class="hidden sm:block">Kategorie</span><span>Jednotka</span><span></span>
        </div><div id="ingredient-list" phx-update="stream" class="divide-y divide-secondary-200">
          <div id="ingredients-empty" class="hidden p-10 text-center text-primary-400 only:block">
            Žádná surovina neodpovídá hledání.
          </div><article
            :for={{id, row} <- @streams.ingredients}
            id={id}
            class="grid grid-cols-[1fr_6rem_3rem] items-center gap-4 px-5 py-4 transition hover:bg-secondary-50 sm:grid-cols-[1fr_12rem_6rem_4rem]"
          >
            <div>
              <h2 class="font-semibold text-primary-500">{row.name}</h2><p
                :if={row.notes}
                class="mt-1 text-xs text-primary-400"
              >
                {row.notes}
              </p>
            </div><span class="hidden text-sm text-primary-400 sm:block">{row.category}</span><span class="w-fit rounded-lg bg-secondary-100 px-3 py-1 text-sm font-semibold text-primary-400">{row.base_unit}</span><.link
              patch={
                CozyCheckoutWeb.FoodNavigation.with_context(
                  ~p"/admin/ingredients/#{row.id}/edit",
                  @food_context
                )
              }
              aria-label={"Upravit "<>row.name}
              class="rounded-lg p-2 text-primary-300 transition hover:bg-tertiary-50 hover:text-tertiary-700"
            ><.icon name="hero-pencil-square" class="h-5 w-5" /></.link>
          </article>
        </div>
      </section>
    </div>
  </div>
  <.modal
    :if={@ingredient}
    id="ingredient-modal"
    show
    on_cancel={
      JS.patch(CozyCheckoutWeb.FoodNavigation.with_context(~p"/admin/ingredients", @food_context))
    }
  >
    <h2 class="mb-5 text-xl font-bold text-primary-500">
      {if @ingredient.id, do: "Upravit surovinu", else: "Nová surovina"}
    </h2><.form for={@form} id="ingredient-form" phx-change="validate" phx-submit="save">
      <.input field={@form[:name]} label="Název suroviny" class={field_class()} required /><div class="mt-4 grid grid-cols-2 gap-4">
        <.input
          field={@form[:category]}
          label="Kategorie"
          placeholder="Např. Zelenina"
          class={field_class()}
          required
        /><.input
          field={@form[:base_unit]}
          type="select"
          label="Základní jednotka"
          options={[{"Kilogram (kg)", "kg"}, {"Litr (l)", "l"}, {"Kus (ks)", "ks"}]}
          class={field_class()}
        />
      </div>
      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        <.input
          field={@form[:purchase_mode]}
          type="select"
          label="Způsob nákupu"
          prompt="Zvolte způsob nákupu"
          options={[{"Na celé období (Sezona)", "Sezona"}, {"Průběžně", "Průběžně"}]}
          class={field_class()}
        />
        <.input
          field={@form[:package_size]}
          type="number"
          step="any"
          min="0.000001"
          label="Velikost balení v základní jednotce (volitelné)"
          class={field_class()}
        />
      </div><p class="my-3 text-xs text-primary-400">
        Recept může používat g místo kg nebo ml místo l. Hmotnost, objem a kusy se vzájemně nepřevádějí.
      </p><.input
        field={@form[:notes]}
        type="textarea"
        label="Poznámka"
        rows="2"
        class={field_class()}
      /><div class="mt-5 flex justify-end">
        <button
          type="submit"
          phx-disable-with="Ukládám…"
          class="rounded-lg bg-primary-500 px-5 py-2.5 font-semibold text-white"
        >Uložit surovinu</button>
      </div>
    </.form>
  </.modal>
</Layouts.app>
