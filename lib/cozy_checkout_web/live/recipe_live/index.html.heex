<Layouts.app
  food_section={:recipes}
  food_context={@food_context}
  flash={@flash}
  show_header={false}
  main_class=""
  content_class=""
>
  <div class="food-page">
    <div class="w-full">
      <.kitchen_header
        title={
          if @recipe,
            do: if(@recipe.id, do: "Upravit recept", else: "Nový recept"),
            else: "Recepty"
        }
        back={if @recipe, do: @editor_back}
        back_label="Zpět na recept"
        subtitle="Všechny receptury na jednom místě. Najděte jídlo, upravte suroviny a přepočítejte množství pro svou skupinu."
      >
        <:actions>
          <.link
            :if={is_nil(@recipe)}
            id="portion-settings"
            navigate={CozyCheckoutWeb.FoodNavigation.path(:settings, @food_context)}
            class="rounded-lg border border-secondary-300 bg-white px-4 py-2.5 text-sm text-primary-500"
          >Porce dětí</.link><.link
            :if={is_nil(@recipe)}
            id="new-recipe"
            patch={
              CozyCheckoutWeb.FoodNavigation.with_context(~p"/admin/recipes/new", @food_context)
            }
            class="inline-flex items-center gap-2 rounded-lg bg-primary-500 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-primary-600"
          ><.icon name="hero-plus" class="h-4 w-4" />Nový recept</.link>
        </:actions>
      </.kitchen_header>
      <div :if={is_nil(@recipe)}>
        <.form
          for={%{}}
          id="recipe-search-form"
          phx-change="search"
          class="mb-6 flex flex-wrap items-center justify-between gap-4"
        >
          <div class="relative w-full max-w-xl">
            <.icon
              name="hero-magnifying-glass"
              class="pointer-events-none absolute left-4 top-3.5 h-5 w-5 text-primary-300"
            /><input
              id="recipe-search"
              name="search"
              type="search"
              value={@search}
              phx-debounce="200"
              placeholder="Najít recept… zkuste třeba kuře nebo polévku"
              aria-label="Hledat recept"
              class="w-full rounded-lg border border-secondary-200 bg-white py-3 pl-12 pr-4 text-sm outline-none transition focus:border-tertiary-400 focus:ring-4 focus:ring-tertiary-50"
            />
          </div><span id="recipe-count" class="text-sm text-primary-400">{@result_count} receptů</span>
        </.form>
        <div
          id="recipe-cards"
          phx-update="stream"
          class="grid gap-5 sm:grid-cols-2 xl:grid-cols-3"
        >
          <div
            id="recipes-empty"
            class="hidden rounded-lg border border-dashed border-secondary-300 p-10 text-center text-primary-400 only:block"
          >
            Žádný recept neodpovídá hledání. Zkuste kratší název.
          </div>
          <article
            :for={{id, recipe} <- @streams.recipes}
            id={id}
            class="group rounded-lg border border-secondary-200 bg-white p-6 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:border-tertiary-300 hover:shadow-sm"
          >
            <div class="mb-5 flex items-center justify-between">
              <span class="rounded-lg bg-secondary-50 p-3 text-tertiary-600"><.icon
                name="hero-book-open"
                class="h-6 w-6"
              /></span><span class="rounded-full bg-secondary-50 px-3 py-1 text-xs font-medium text-primary-400">{Decimal.to_string(
                Decimal.normalize(recipe.base_servings),
                :normal
              )} porcí / dávka</span>
            </div>
            <h2 class="min-h-14 text-lg font-bold leading-snug text-primary-500">
              <.link
                navigate={
                  CozyCheckoutWeb.FoodNavigation.with_context(
                    ~p"/admin/recipes/#{recipe.id}",
                    @food_context
                  )
                }
                class="transition hover:text-tertiary-700"
              >{recipe.name}</.link>
            </h2>
            <p class="mt-3 text-sm text-primary-400">
              {length(recipe.lines)} surovin
              <span :if={recipe.source_key == "kitchen:breakfast-buffet:v1"}>· pracovní norma bufetu</span>
              <span :if={recipe.source_key && recipe.source_key != "kitchen:breakfast-buffet:v1"}>· z podkladové tabulky</span>
            </p>
            <.link
              navigate={
                CozyCheckoutWeb.FoodNavigation.with_context(
                  ~p"/admin/recipes/#{recipe.id}",
                  @food_context
                )
              }
              class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-tertiary-600"
            >Otevřít a přepočítat
            <.icon name="hero-arrow-right" class="h-4 w-4 transition group-hover:translate-x-1" /></.link>
          </article>
        </div>
      </div>
      <.form
        :if={@recipe}
        for={@form}
        id="recipe-form"
        phx-change="validate"
        phx-submit="save"
        class="mx-auto max-w-5xl space-y-6"
      >
        <section class="rounded-lg border border-secondary-200 bg-white p-6 shadow-sm">
          <h2 class="mb-5 text-lg font-bold text-primary-500">Základ receptu</h2><div class="grid gap-5 sm:grid-cols-[1fr_12rem]">
            <.input field={@form[:name]} label="Název receptu" class={field_class()} required /><.input
              field={@form[:base_servings]}
              type="number"
              step="any"
              min="0.001"
              label="Porcí z jedné dávky"
              class={field_class()}
              required
            />
          </div><div class="mt-4 grid gap-5 sm:grid-cols-2">
            <.input
              field={@form[:source_reference]}
              label="Zdroj nebo odkaz (volitelné)"
              class={field_class()}
            /><.input
              field={@form[:notes]}
              type="textarea"
              label="Poznámka k receptu"
              rows="2"
              class={field_class()}
            />
          </div>
        </section>
        <section class="rounded-lg border border-secondary-200 bg-white p-6 shadow-sm">
          <div class="mb-5">
            <h2 class="text-lg font-bold text-primary-500">Suroviny na celou dávku</h2><p class="mt-1 text-sm text-primary-400">
              Zadejte množství pro počet porcí výše. Gramy a mililitry se při výpočtu převedou automaticky.
            </p>
          </div>
          <div
            :if={@form[:lines].errors != []}
            id="recipe-lines-errors"
            role="alert"
            class="mb-3 text-sm text-red-700"
          >
            <p :for={{message, _} <- @form[:lines].errors}>{message}</p>
          </div>
          <div class="space-y-3">
            <.inputs_for :let={line} field={@form[:lines]}>
              <div class="rounded-lg border border-secondary-200 bg-secondary-50/70 p-4">
                <div class="grid items-end gap-3 sm:grid-cols-[1fr_8rem_6rem_auto]">
                  <.ingredient_picker
                    field={line[:ingredient_id]}
                    ingredients={@ingredients}
                    index={to_string(line.index)}
                    query={@ingredient_queries[to_string(line.index)]}
                    open={@active_ingredient == to_string(line.index)}
                  /><.input
                    field={line[:quantity]}
                    type="number"
                    step="any"
                    min="0"
                    label="Množství"
                    class={field_class()}
                    required
                  /><.input
                    field={line[:unit]}
                    type="select"
                    label="Jednotka"
                    options={~w(kg g l ml ks)}
                    class={field_class()}
                  /><button
                    type="button"
                    phx-click="remove_line"
                    phx-value-index={line.index}
                    aria-label="Odebrat surovinu"
                    class="mb-2 rounded-lg p-2 text-primary-300 hover:bg-red-50 hover:text-red-700"
                  ><.icon name="hero-trash" class="h-5 w-5" /></button>
                </div><details class="mt-2 text-xs text-primary-400">
                  <summary class="cursor-pointer">Poznámka nebo pracovní odhad</summary><.input
                    field={line[:notes]}
                    label="Poznámka k množství"
                    class={field_class()}
                  />
                </details>
              </div>
            </.inputs_for>
          </div>
          <button
            id="add-recipe-line"
            type="button"
            phx-click="add_line"
            class="mt-5 inline-flex items-center gap-2 rounded-lg border border-dashed border-secondary-300 px-4 py-2.5 text-sm font-semibold text-tertiary-600 hover:bg-tertiary-50"
          ><.icon name="hero-plus" class="h-4 w-4" />Přidat surovinu</button><p class="mt-4 text-xs text-primary-400">
            Surovina v seznamu chybí?
            <button
              id="quick-new-ingredient"
              type="button"
              phx-click="new_ingredient"
              class="font-semibold text-tertiary-600 underline"
            >Založit novou surovinu</button>
          </p>
        </section>
        <div class="sticky bottom-4 flex items-center justify-between rounded-lg border border-secondary-200 bg-white/95 p-4 shadow-sm backdrop-blur">
          <.link navigate={@editor_back} class="px-3 text-sm font-semibold text-primary-400">Zrušit</.link><button
            type="submit"
            id="save-recipe"
            phx-disable-with="Ukládám…"
            class="rounded-lg bg-primary-500 px-6 py-3 text-sm font-semibold text-white transition hover:bg-primary-600"
          >Uložit recept</button>
        </div>
      </.form>
    </div>
  </div>
  <.modal
    :if={@quick_ingredient_open}
    id="quick-ingredient-modal"
    show
    on_cancel={JS.push("close_ingredient")}
  >
    <h2 class="mb-3 text-xl font-bold text-primary-500">Nová surovina</h2>
    <p class="mb-5 text-sm text-primary-400">
      Rozpracovaný recept zůstane zachovaný. Surovinu rovnou přidáme do receptu.
    </p>
    <.form for={@quick_ingredient_form} id="quick-ingredient-form" phx-submit="save_ingredient">
      <.input
        field={@quick_ingredient_form[:name]}
        label="Název suroviny"
        class={field_class()}
        required
      />
      <div class="mt-4 grid grid-cols-2 gap-4">
        <.input
          field={@quick_ingredient_form[:category]}
          label="Kategorie"
          class={field_class()}
          required
        />
        <.input
          field={@quick_ingredient_form[:base_unit]}
          type="select"
          label="Základní jednotka"
          options={[{"Kilogram (kg)", "kg"}, {"Litr (l)", "l"}, {"Kus (ks)", "ks"}]}
          class={field_class()}
        />
      </div>
      <button
        type="submit"
        phx-disable-with="Ukládám…"
        class="mt-5 rounded-lg bg-primary-500 px-5 py-2.5 font-semibold text-white"
      >Přidat do receptu</button>
    </.form>
  </.modal>
</Layouts.app>
