<Layouts.app
  food_section={@food_section}
  food_context={@food_context}
  flash={@flash}
  show_header={false}
>
  <div :if={not @redirecting} class="space-y-5">
    <.link id="food-back" navigate={@back} class="text-tertiary-600 underline">{@back_label}</.link>
    <p id="recipe-link-context">
      {@item.booking_menu.booking.guest.name} · den {@item.day_number}
    </p>
    <h1 class="text-2xl font-semibold">
      {CozyCheckout.Meals.MenuRecipes.display(@item).main || "Podání bez hlavního receptu"}
    </h1>
    <p class="whitespace-pre-line">{CozyCheckout.Meals.MenuRecipes.display(@item).supplements}</p>
    <p :if={@item.note}>Poznámka: {@item.note}</p>
    <p class="text-sm text-primary-400">
      Výpočet používá aktuální recepturu a počty porcí, také pro minulé datum.
    </p>
    <.link
      id="edit-menu-recipes"
      navigate={@edit_path}
      class="inline-block rounded-lg border px-4 py-2 text-tertiary-600"
    >Upravit podání v menu pobytu</.link>
    <p
      :if={@error}
      id="recipe-link-blocked"
      role="alert"
      class="rounded-lg bg-amber-50 p-4 text-amber-900"
    >
      {@error}
    </p>
    <.consumption_table :if={@result} id="menu-consumption" result={@result} />
  </div>
</Layouts.app>
