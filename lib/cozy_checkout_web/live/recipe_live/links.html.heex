<Layouts.app flash={@flash} show_header={false} main_class="" content_class="">
  <div class="min-h-screen bg-slate-50 px-4 py-8 font-sans sm:px-8">
    <div class="mx-auto max-w-7xl">
      <.link
        navigate={@back}
        class="inline-flex items-center gap-2 text-sm font-medium text-slate-500 hover:text-emerald-700"
      ><.icon name="hero-arrow-left" class="h-4 w-4" />Zpět k menu</.link>
      <header class="my-7">
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-emerald-700">
          Sestavit jídlo
        </p><h1 class="mt-2 text-3xl font-bold text-slate-900">{@item.menu_text}</h1><p
          :if={@item.supplements}
          class="mt-2 whitespace-pre-line text-slate-500"
        >
          {@item.supplements}
        </p><p class="mt-3 text-sm text-slate-500">
          Vyberte hlavní recept a případné doplňky. Text jídelníčku se nepřepisuje. Výběr potvrďte tlačítkem Uložit.
        </p>
      </header>
      <p
        :if={@blocked}
        id="recipe-link-blocked"
        class="mb-6 rounded-2xl border border-amber-200 bg-amber-50 p-5 text-sm text-amber-900"
      >
        {@blocked}
      </p>
      <div class="grid items-start gap-6 xl:grid-cols-[1fr_24rem]">
        <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <.form for={%{}} id="link-search-form" phx-change="search">
            <input
              id="link-recipe-search"
              name="search"
              type="search"
              value={@search}
              phx-debounce="150"
              placeholder="Hledat recept podle názvu…"
              aria-label="Najít recept k jídlu"
              class={field_class()}
            />
          </.form><p class="my-4 text-xs text-slate-500">
            {@result_count} receptů · každý doplněk se počítá pro stejnou skupinu
          </p><div
            id="recipe-choices"
            phx-update="stream"
            class="max-h-[34rem] space-y-2 overflow-y-auto pr-1"
          >
            <div
              id="recipe-choices-empty"
              class="hidden py-10 text-center text-sm text-slate-500 only:block"
            >
              Žádný recept nenalezen.
            </div><article
              :for={{id, recipe} <- @streams.choices}
              id={id}
              class="rounded-xl border border-slate-100 p-4 transition hover:border-emerald-200 hover:bg-emerald-50/40"
            >
              <h2 class="font-semibold text-slate-800">{recipe.name}</h2><div class="mt-3 flex flex-wrap gap-2">
                <button
                  id={"choose-main-#{recipe.id}"}
                  type="button"
                  phx-click="select_main"
                  phx-value-id={recipe.id}
                  class="rounded-lg bg-emerald-700 px-3 py-1.5 text-xs font-semibold text-white transition hover:bg-emerald-800"
                >Jako hlavní recept</button><button
                  id={"choose-extra-#{recipe.id}"}
                  type="button"
                  phx-click="add_extra"
                  phx-value-id={recipe.id}
                  class="rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-slate-600 transition hover:border-emerald-300"
                >+ Doplněk</button><.link
                  navigate={~p"/admin/recipes/#{recipe.id}"}
                  target="_blank"
                  class="self-center px-2 text-xs text-slate-500 underline"
                >Zobrazit recept</.link>
              </div>
            </article>
          </div>
        </section>
        <aside class="space-y-5 xl:sticky xl:top-5">
          <section class="rounded-2xl border border-emerald-200 bg-white p-5 shadow-sm">
            <h2 class="font-bold text-slate-900">Vybrané recepty</h2><p class="mb-3 mt-4 text-xs font-semibold uppercase tracking-wide text-slate-500">
              Hlavní chod / bufet
            </p><div
              :if={@main}
              id="selected-main-recipe"
              class="flex items-start justify-between gap-3 rounded-xl bg-emerald-50 p-3"
            >
              <span class="text-sm font-semibold text-emerald-900">{@main.name}</span><button
                type="button"
                phx-click="remove_main"
                aria-label="Odebrat hlavní recept"
                class="text-emerald-700"
              ><.icon name="hero-x-mark" class="h-4 w-4" /></button>
            </div><p
              :if={is_nil(@main)}
              class="rounded-xl border border-dashed border-slate-300 p-3 text-sm text-slate-400"
            >
              Zatím není vybraný hlavní recept
            </p><p class="mb-3 mt-5 text-xs font-semibold uppercase tracking-wide text-slate-500">
              Doplňky
            </p><div class="space-y-2">
              <div
                :for={recipe <- @extras}
                id={"selected-extra-#{recipe.id}"}
                class="flex items-start justify-between gap-3 rounded-xl bg-slate-50 p-3"
              >
                <span class="text-sm font-medium text-slate-700">{recipe.name}</span><button
                  type="button"
                  phx-click="remove_extra"
                  phx-value-id={recipe.id}
                  aria-label={"Odebrat "<>recipe.name}
                  class="text-slate-400"
                ><.icon name="hero-x-mark" class="h-4 w-4" /></button>
              </div>
            </div><button
              id="save-recipe-links"
              type="button"
              phx-click="save"
              disabled={not is_nil(@blocked)}
              phx-disable-with="Ukládám…"
              class="mt-6 w-full rounded-xl bg-emerald-700 px-5 py-3 text-sm font-semibold text-white transition hover:bg-emerald-800 disabled:opacity-40"
            >Uložit recepty k jídlu</button>
          </section>
          <section
            :if={@kind == "variant"}
            class="rounded-2xl border border-slate-200 bg-white p-5"
          >
            <h2 class="mb-4 font-semibold text-slate-900">Náhled pro skupinu</h2><.form
              for={@calculator}
              id="variant-consumption-calculator"
              phx-change="calculate"
              class="grid grid-cols-2 gap-3"
            >
              <.input
                field={@calculator[:adults]}
                type="number"
                min="0"
                step="1"
                label="Dospělí"
                class={field_class()}
              /><.input
                field={@calculator[:children]}
                type="number"
                min="0"
                step="1"
                label="Děti"
                class={field_class()}
              />
            </.form><p :if={@calculator_error} class="mt-2 text-sm text-red-700">
              {@calculator_error}
            </p>
          </section>
        </aside>
      </div>
      <div :if={is_nil(@blocked)} class="mt-6">
        <p class="mb-3 text-sm font-medium text-slate-500">
          Náhled podle aktuálního výběru receptů
        </p><.consumption_table id="menu-consumption" result={@result} />
      </div>
    </div>
  </div>
</Layouts.app>
