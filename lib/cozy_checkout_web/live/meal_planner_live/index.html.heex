<Layouts.app
  food_section={:planner}
  food_context={@food_context}
  flash={@flash}
  show_header={false}
  main_class=""
  content_class=""
>
  <div class="w-full">
    <.kitchen_header
      title="Plán jídel"
      subtitle="Týdenní přehled všech skupin, jejich menu a počtů porcí."
    >
      <:actions>
        <.link
          id="kitchen-shopping-link"
          navigate={CozyCheckoutWeb.FoodNavigation.path(:shopping, @food_context)}
          class="rounded-lg bg-primary-500 px-4 py-2.5 text-sm font-semibold text-white hover:bg-primary-600"
        >Zobrazit nákup</.link>
        <.link
          navigate={~p"/admin/meal-planner/print?week=#{Date.to_iso8601(@week_start)}"}
          target="_blank"
          class="inline-flex items-center gap-2 rounded-lg border border-secondary-300 bg-white px-4 py-2.5 text-sm text-primary-500"
        ><.icon name="hero-printer" class="h-4 w-4" />Tisk jídelníčku</.link>
      </:actions>
    </.kitchen_header>

    <div class="flex min-w-0 flex-col gap-6 2xl:flex-row">
      <%!-- Main Content --%>
      <div class="min-w-0 flex-1">
        <%!-- Week Navigation --%>
        <div class="bg-white shadow-sm rounded-lg p-6 mb-6">
          <div class="flex justify-between items-center">
            <button
              aria-label="Předchozí týden"
              phx-click="prev_week"
              class="p-2 rounded-lg hover:bg-secondary-100 transition-colors"
            >
              <.icon name="hero-chevron-left" class="w-6 h-6 text-primary-400" />
            </button>

            <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-4">
              <h2 class="text-lg font-bold text-primary-500 sm:text-2xl">
                {format_date(@week_start)} – {format_date(Date.add(@week_start, 6))}
              </h2>
              <button
                phx-click="today"
                class="px-4 py-2 text-sm font-medium text-tertiary-600 hover:bg-tertiary-50 rounded-lg transition-colors"
              >
                Tento týden
              </button>
            </div>

            <button
              aria-label="Následující týden"
              phx-click="next_week"
              class="p-2 rounded-lg hover:bg-secondary-100 transition-colors"
            >
              <.icon name="hero-chevron-right" class="w-6 h-6 text-primary-400" />
            </button>
          </div>
        </div>

        <.incomplete_catering_notice bookings={@incomplete_bookings} />
        <.menu_issues issues={@menu_issues} />
        <p class="mb-4 text-sm text-primary-400">
          Celkové porce zahrnují všechny skupiny. Kliknutím na název skupiny otevřete její jídelníček.
        </p>

        <%!-- Desktop: Weekly Grid --%>
        <div class="hidden lg:block bg-white shadow-sm rounded-lg overflow-hidden">
          <table class="w-full table-fixed">
            <thead class="bg-secondary-50">
              <tr>
                <th class="px-4 py-3 text-left text-xs font-semibold text-primary-400 uppercase w-32">
                  Den
                </th>
                <th class="px-4 py-3 text-left text-xs font-semibold text-primary-400 uppercase">
                  Snídaně
                </th>
                <th class="px-4 py-3 text-left text-xs font-semibold text-primary-400 uppercase">
                  Oběd
                </th>
                <th class="px-4 py-3 text-left text-xs font-semibold text-primary-400 uppercase">
                  Večeře
                </th>
              </tr>
            </thead>
            <tbody>
              <%= for day <- @week_days do %>
                <tr class="border-t border-secondary-200 hover:bg-secondary-50">
                  <td class="px-4 py-4 align-top">
                    <div class="font-semibold text-primary-500">{day_name(day.date)}</div>
                    <div class="text-sm text-primary-400">{format_date(day.date)}</div>

                    <button
                      type="button"
                      phx-click="show_guest_bookings"
                      phx-value-date={day.date}
                      class={[
                        "mt-2 text-sm cursor-pointer hover:underline transition-colors",
                        guest_count_class(day.guest_count)
                      ]}
                    >
                      {day.guest_count} hostů
                    </button>
                  </td>
                  <%= for meal_type <- ["breakfast", "lunch", "dinner"] do %>
                    <td class="px-4 py-4 align-top">
                      <.portion_count
                        id={"portions-#{day.date}-#{meal_type}"}
                        counts={Map.fetch!(day.portions, meal_type)}
                        incomplete={day.portions.incomplete_bookings != []}
                      />
                      <.menu_coverage
                        id={"menu-coverage-#{day.date}-#{meal_type}"}
                        day={day}
                        meal_type={meal_type}
                      />
                      <.group_menus
                        id={"group-menus-#{day.date}-#{meal_type}"}
                        groups={day.group_menus[meal_type]}
                      />
                    </td>
                  <% end %>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <%!-- Mobile: Accordion --%>
        <div class="lg:hidden space-y-4">
          <%= for day <- @week_days do %>
            <div class="bg-white shadow-sm rounded-lg overflow-hidden">
              <div class="bg-secondary-50 px-4 py-3 border-b border-secondary-200">
                <div class="flex justify-between items-center">
                  <div>
                    <div class="font-semibold text-primary-500">
                      {day_name(day.date)}, {format_date(day.date)}
                    </div>
                  </div>
                  <button
                    type="button"
                    phx-click="show_guest_bookings"
                    phx-value-date={day.date}
                    class={[
                      "cursor-pointer hover:underline transition-colors",
                      guest_count_class(day.guest_count)
                    ]}
                  >
                    {day.guest_count} hostů
                  </button>
                </div>
              </div>
              <div class="divide-y divide-secondary-200">
                <%= for meal_type <- ["breakfast", "lunch", "dinner"] do %>
                  <div class="px-4 py-4">
                    <div class="flex items-start gap-3">
                      <span class="text-2xl">{meal_type_emoji(meal_type)}</span>
                      <div class="flex-1">
                        <div class="font-medium text-primary-500 mb-1">
                          {meal_type_label(meal_type)}
                        </div>
                        <.portion_count
                          id={"mobile-portions-#{day.date}-#{meal_type}"}
                          counts={Map.fetch!(day.portions, meal_type)}
                          incomplete={day.portions.incomplete_bookings != []}
                        />
                        <.menu_coverage
                          id={"mobile-menu-coverage-#{day.date}-#{meal_type}"}
                          day={day}
                          meal_type={meal_type}
                        />
                        <.group_menus
                          id={"mobile-group-menus-#{day.date}-#{meal_type}"}
                          groups={day.group_menus[meal_type]}
                        />
                      </div>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <%!-- Diety a alergie --%>
      <div id="planner-dietary-panel" class="w-full shrink-0 2xl:w-72">
        <div class="bg-white shadow-sm rounded-lg overflow-hidden sticky top-8">
          <div class="bg-secondary-50 px-4 py-3 border-b border-secondary-200 flex justify-between items-center">
            <h3 class="font-semibold text-primary-500 flex items-center gap-2">
              <span>🔴</span> Diety a alergie
            </h3>
            <button
              aria-label="Diety a alergie"
              aria-expanded={to_string(@dietary_panel_open)}
              aria-controls="planner-dietary-content"
              phx-click="toggle_dietary_panel"
              class="p-1 hover:bg-secondary-200 rounded transition-colors"
            >
              <.icon
                name={if @dietary_panel_open, do: "hero-chevron-up", else: "hero-chevron-down"}
                class="w-5 h-5 text-primary-400"
              />
            </button>
          </div>
          <%= if @dietary_panel_open do %>
            <div id="planner-dietary-content" class="p-4 max-h-[600px] overflow-y-auto">
              <%= if @dietary_restrictions == [] do %>
                <p class="text-sm text-primary-400 italic">
                  V tomto týdnu nejsou zadané diety ani alergie
                </p>
              <% else %>
                <div class="space-y-4">
                  <%= for restriction <- @dietary_restrictions do %>
                    <div class="border-b border-secondary-200 pb-3 last:border-b-0">
                      <div class="font-medium text-primary-500 mb-1">
                        {restriction.guest_name}
                      </div>
                      <div class="text-xs text-primary-400 mb-2">
                        <%= if restriction.room_number do %>
                          Pokoj {restriction.room_number} •
                        <% end %>
                        {format_date(restriction.check_in_date)} - {format_date(
                          restriction.check_out_date || Date.utc_today()
                        )}
                      </div>
                      <div class="text-sm text-error bg-error-light px-3 py-2 rounded whitespace-pre-line">
                        {restriction.dietary_restrictions}
                      </div>
                    </div>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <%!-- Bookings Modal --%>
  <.bookings_modal
    date={@modal_date}
    bookings={@modal_bookings}
    on_close={JS.push("close_bookings_modal")}
  />
</Layouts.app>
