<Layouts.app
  food_section={:planner}
  food_context={@food_context}
  flash={@flash}
  show_header={false}
  main_class=""
  content_class=""
>
  <div class="w-full">
    <.kitchen_header
      title="Plán jídel"
      subtitle="Týdenní přehled všech skupin, jejich menu a počtů porcí."
    >
      <:actions>
        <.link
          id="kitchen-shopping-link"
          navigate={CozyCheckoutWeb.FoodNavigation.path(:shopping, @food_context)}
          class="rounded-lg bg-primary-500 px-4 py-2.5 text-sm font-semibold text-white hover:bg-primary-600"
        >Zobrazit nákup</.link>
        <.link
          navigate={~p"/admin/meal-planner/print?week=#{Date.to_iso8601(@week_start)}"}
          target="_blank"
          class="inline-flex items-center gap-2 rounded-lg border border-secondary-300 bg-white px-4 py-2.5 text-sm text-primary-500"
        ><.icon name="hero-printer" class="h-4 w-4" />Tisk jídelníčku</.link>
      </:actions>
    </.kitchen_header>

    <div class="flex min-w-0 flex-col gap-6 2xl:flex-row">
      <%!-- Main Content --%>
      <div class="min-w-0 flex-1">
        <%!-- Week Navigation --%>
        <div class="bg-white shadow-sm rounded-lg p-6 mb-6">
          <div class="flex justify-between items-center">
            <button
              phx-click="prev_week"
              class="p-2 rounded-lg hover:bg-secondary-100 transition-colors"
            >
              <.icon name="hero-chevron-left" class="w-6 h-6 text-primary-400" />
            </button>

            <div class="flex items-center gap-4">
              <h2 class="text-2xl font-bold text-primary-500">
                Týden od {format_date(@week_start)}
              </h2>
              <button
                phx-click="today"
                class="px-4 py-2 text-sm font-medium text-tertiary-600 hover:bg-tertiary-50 rounded-lg transition-colors"
              >
                Tento týden
              </button>
            </div>

            <button
              phx-click="next_week"
              class="p-2 rounded-lg hover:bg-secondary-100 transition-colors"
            >
              <.icon name="hero-chevron-right" class="w-6 h-6 text-primary-400" />
            </button>
          </div>
        </div>

        <.incomplete_catering_notice bookings={@incomplete_bookings} />
        <.menu_issues issues={@menu_issues} />
        <p class="mb-4 text-sm text-primary-400">
          Celkové porce zahrnují všechny skupiny níže. Každá skupina má vlastní menu; společné menu lze upravovat samostatně.
        </p>

        <%!-- Desktop: Weekly Grid --%>
        <div class="hidden lg:block bg-white shadow-sm rounded-lg overflow-hidden">
          <table class="w-full">
            <thead class="bg-secondary-50">
              <tr>
                <th class="px-4 py-3 text-left text-xs font-semibold text-primary-400 uppercase w-32">
                  Day
                </th>
                <th class="px-4 py-3 text-center text-xs font-semibold text-primary-400 uppercase w-24">
                  Ubytovaní
                </th>
                <th class="px-4 py-3 text-left text-xs font-semibold text-primary-400 uppercase">
                  Snídaně
                </th>
                <th class="px-4 py-3 text-left text-xs font-semibold text-primary-400 uppercase">
                  Oběd
                </th>
                <th class="px-4 py-3 text-left text-xs font-semibold text-primary-400 uppercase">
                  Večeře
                </th>
              </tr>
            </thead>
            <tbody>
              <%= for day <- @week_days do %>
                <tr class="border-t border-secondary-200 hover:bg-secondary-50">
                  <td class="px-4 py-4">
                    <div class="font-semibold text-primary-500">{day_name(day.date)}</div>
                    <div class="text-sm text-primary-400">{format_date(day.date)}</div>
                  </td>
                  <td class="px-4 py-4 text-center">
                    <button
                      type="button"
                      phx-click="show_guest_bookings"
                      phx-value-date={day.date}
                      class={[
                        "cursor-pointer hover:underline transition-colors",
                        guest_count_class(day.guest_count)
                      ]}
                    >
                      {day.guest_count}
                    </button>
                  </td>
                  <%= for meal_type <- ["breakfast", "lunch", "dinner"] do %>
                    <% meal = Map.get(day.meals, meal_type) %>
                    <td
                      class="px-4 py-4 cursor-pointer hover:bg-tertiary-50 transition-colors"
                      phx-click="open_edit_modal"
                      phx-value-date={day.date}
                      phx-value-type={meal_type}
                    >
                      <.portion_count
                        id={"portions-#{day.date}-#{meal_type}"}
                        counts={Map.fetch!(day.portions, meal_type)}
                        incomplete={day.portions.incomplete_bookings != []}
                      />
                      <p class="mb-1 text-xs font-semibold text-primary-400">Společné menu</p>
                      <%= if meal && meal.menu_text && meal.menu_text != "" do %>
                        <div class="space-y-1">
                          <div class="text-sm text-primary-500 whitespace-pre-line">
                            {meal.menu_text}
                          </div>
                          <%= if has_dietary_notes?(meal) do %>
                            <div class="flex items-center gap-1 text-xs text-error">
                              <span>🔴</span>
                              <span>Diety a alergie</span>
                            </div>
                          <% end %>
                        </div>
                      <% else %>
                        <div class="flex items-center gap-2 text-sm text-primary-300">
                          <%= if needs_planning?(uncovered_count(day, meal_type), meal) do %>
                            <span class="text-warning">⚠️</span>
                          <% end %>
                          <span>Doplnit společné menu</span>
                        </div>
                      <% end %>
                      <.group_menus
                        id={"group-menus-#{day.date}-#{meal_type}"}
                        groups={day.group_menus[meal_type]}
                        shared_text={if meal, do: meal.menu_text}
                      />
                    </td>
                  <% end %>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <%!-- Mobile: Accordion --%>
        <div class="lg:hidden space-y-4">
          <%= for day <- @week_days do %>
            <div class="bg-white shadow-sm rounded-lg overflow-hidden">
              <div class="bg-secondary-50 px-4 py-3 border-b border-secondary-200">
                <div class="flex justify-between items-center">
                  <div>
                    <div class="font-semibold text-primary-500">
                      {day_name(day.date)}, {format_date(day.date)}
                    </div>
                  </div>
                  <button
                    type="button"
                    phx-click="show_guest_bookings"
                    phx-value-date={day.date}
                    class={[
                      "cursor-pointer hover:underline transition-colors",
                      guest_count_class(day.guest_count)
                    ]}
                  >
                    {day.guest_count} hostů
                  </button>
                </div>
              </div>
              <div class="divide-y divide-secondary-200">
                <%= for meal_type <- ["breakfast", "lunch", "dinner"] do %>
                  <% meal = Map.get(day.meals, meal_type) %>
                  <div
                    class="px-4 py-4 cursor-pointer hover:bg-tertiary-50 transition-colors"
                    phx-click="open_edit_modal"
                    phx-value-date={day.date}
                    phx-value-type={meal_type}
                  >
                    <div class="flex items-start gap-3">
                      <span class="text-2xl">{meal_type_emoji(meal_type)}</span>
                      <div class="flex-1">
                        <div class="font-medium text-primary-500 mb-1">
                          {meal_type_label(meal_type)}
                        </div>
                        <p class="mb-1 text-xs font-semibold text-primary-400">Společné menu</p>
                        <.portion_count
                          id={"mobile-portions-#{day.date}-#{meal_type}"}
                          counts={Map.fetch!(day.portions, meal_type)}
                          incomplete={day.portions.incomplete_bookings != []}
                        />
                        <%= if meal && meal.menu_text && meal.menu_text != "" do %>
                          <div class="text-sm text-primary-400 whitespace-pre-line">
                            {meal.menu_text}
                          </div>
                          <%= if has_dietary_notes?(meal) do %>
                            <div class="flex items-center gap-1 text-xs text-error mt-2">
                              <span>🔴</span>
                              <span>Diety a alergie</span>
                            </div>
                          <% end %>
                        <% else %>
                          <div class="flex items-center gap-2 text-sm text-primary-300">
                            <%= if needs_planning?(uncovered_count(day, meal_type), meal) do %>
                              <span class="text-warning">⚠️</span>
                            <% end %>
                            <span>Doplnit společné menu</span>
                          </div>
                        <% end %>
                        <.group_menus
                          id={"mobile-group-menus-#{day.date}-#{meal_type}"}
                          groups={day.group_menus[meal_type]}
                          shared_text={if meal, do: meal.menu_text}
                        />
                      </div>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <%!-- Diety a alergie Sidebar (Desktop only) --%>
      <div class="hidden w-full shrink-0 lg:block 2xl:w-72">
        <div class="bg-white shadow-sm rounded-lg overflow-hidden sticky top-8">
          <div class="bg-secondary-50 px-4 py-3 border-b border-secondary-200 flex justify-between items-center">
            <h3 class="font-semibold text-primary-500 flex items-center gap-2">
              <span>🔴</span> Diety a alergie
            </h3>
            <button
              phx-click="toggle_dietary_panel"
              class="p-1 hover:bg-secondary-200 rounded transition-colors"
            >
              <.icon
                name={if @dietary_panel_open, do: "hero-chevron-up", else: "hero-chevron-down"}
                class="w-5 h-5 text-primary-400"
              />
            </button>
          </div>
          <%= if @dietary_panel_open do %>
            <div class="p-4 max-h-[600px] overflow-y-auto">
              <%= if @dietary_restrictions == [] do %>
                <p class="text-sm text-primary-400 italic">
                  V tomto týdnu nejsou zadané diety ani alergie
                </p>
              <% else %>
                <div class="space-y-4">
                  <%= for restriction <- @dietary_restrictions do %>
                    <div class="border-b border-secondary-200 pb-3 last:border-b-0">
                      <div class="font-medium text-primary-500 mb-1">
                        {restriction.guest_name}
                      </div>
                      <div class="text-xs text-primary-400 mb-2">
                        <%= if restriction.room_number do %>
                          Pokoj {restriction.room_number} •
                        <% end %>
                        {format_date(restriction.check_in_date)} - {format_date(
                          restriction.check_out_date || Date.utc_today()
                        )}
                      </div>
                      <div class="text-sm text-error bg-error-light px-3 py-2 rounded whitespace-pre-line">
                        {restriction.dietary_restrictions}
                      </div>
                    </div>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <%!-- Upravit Meal Modal --%>
  <%= if @edit_modal_open do %>
    <div
      class="fixed inset-0 bg-primary-500 bg-opacity-75 flex items-center justify-center z-50 p-4"
      id="modal-backdrop"
      phx-click="close_edit_modal"
    >
      <div
        class="bg-white rounded-lg shadow-xl max-w-2xl w-full max-h-[90vh] overflow-y-auto"
        phx-window-keydown="close_edit_modal"
        phx-key="escape"
        phx-click="noop"
      >
        <div class="px-6 py-4 border-b border-secondary-200">
          <div class="flex justify-between items-start">
            <div>
              <h3 class="text-xl font-bold text-primary-500 flex items-center gap-2">
                <span>{meal_type_emoji(@edit_meal_type)}</span>
                <span>{meal_type_label(@edit_meal_type)}</span>
              </h3>
              <p class="text-sm text-primary-400 mt-1">
                {day_name(@edit_date)}, {format_date(@edit_date)}
              </p>
            </div>
            <button
              phx-click="close_edit_modal"
              class="text-primary-400 hover:text-primary-500 transition-colors"
            >
              <.icon name="hero-x-mark" class="w-6 h-6" />
            </button>
          </div>
        </div>

        <.form for={%{}} phx-change="validate_meal" phx-submit="save_meal" id="meal-form">
          <div class="px-6 py-4 space-y-4">
            <%!-- Guest Count Info --%>
            <% day = Enum.find(@week_days, &(&1.date == @edit_date)) %>
            <div class="bg-secondary-50 px-4 py-3 rounded-lg">
              <span class="text-sm text-primary-400">Počty pro toto jídlo:</span>
              <.portion_count
                id="edit-meal-portions"
                counts={Map.fetch!(day.portions, @edit_meal_type)}
                incomplete={day.portions.incomplete_bookings != []}
              />
            </div>

            <%!-- Menu Text --%>
            <div>
              <label class="block text-sm font-medium text-primary-500 mb-2">
                Menu
              </label>
              <textarea
                name="meal[menu_text]"
                rows="4"
                placeholder="Např. svíčková s houskovým knedlíkem"
                class="w-full px-4 py-3 border border-secondary-300 rounded-lg focus:ring-2 focus:ring-tertiary-500 focus:border-transparent transition-all"
              >{@edit_menu_text}</textarea>
            </div>

            <%!-- Dietary Notes --%>
            <div>
              <label class="block text-sm font-medium text-primary-500 mb-2">
                Diety a alergie
              </label>
              <textarea
                name="meal[dietary_notes]"
                rows="3"
                placeholder="Např. pokoj 3: bez lepku (pouze polévka)"
                class="w-full px-4 py-3 border border-secondary-300 rounded-lg focus:ring-2 focus:ring-tertiary-500 focus:border-transparent transition-all"
              >{@edit_dietary_notes}</textarea>
            </div>

            <%!-- Rychlé akce --%>
            <div class="border-t border-secondary-200 pt-4">
              <div class="text-sm font-medium text-primary-500 mb-3">Rychlé akce</div>
              <div class="flex flex-wrap gap-2">
                <button
                  type="button"
                  phx-click="copy_from_yesterday"
                  class="px-4 py-2 text-sm bg-secondary-100 hover:bg-secondary-200 text-primary-500 rounded-lg transition-colors"
                >
                  Převzít ze včerejška
                </button>
                <button
                  type="button"
                  phx-click="copy_to_week"
                  class="px-4 py-2 text-sm bg-secondary-100 hover:bg-secondary-200 text-primary-500 rounded-lg transition-colors"
                >
                  Zkopírovat do konce týdne
                </button>
              </div>
            </div>
          </div>

          <div class="px-6 py-4 bg-secondary-50 border-t border-secondary-200 flex justify-end gap-3">
            <button
              type="button"
              phx-click="close_edit_modal"
              class="px-6 py-2 text-sm font-medium text-primary-400 hover:text-primary-500 transition-colors"
            >
              Zrušit
            </button>
            <button
              type="submit"
              class="px-6 py-2 text-sm font-medium bg-tertiary-600 hover:bg-tertiary-700 text-white rounded-lg transition-colors"
            >
              Uložit jídlo
            </button>
          </div>
        </.form>
      </div>
    </div>
  <% end %>

  <%!-- Bookings Modal --%>
  <.bookings_modal
    date={@modal_date}
    bookings={@modal_bookings}
    on_close={JS.push("close_bookings_modal")}
  />
</Layouts.app>
