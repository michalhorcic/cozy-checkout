<div
  id={@id}
  phx-hook="MenuEditor"
  phx-target={@myself}
  data-dirty={to_string(@draft != @initial)}
  data-library-open={to_string(@library_open)}
  class="space-y-4"
>
  <p :if={@error} role="alert" class="rounded-lg bg-red-50 p-4 text-red-800">{@error}</p>
  <div class="flex flex-wrap items-center gap-4 rounded-lg bg-secondary-50 p-4">
    <span class="font-semibold">Vyplněno {Enum.count(
      @draft["items"],
      &(&1["recipe_id"] not in [nil, ""])
    )} / {length(@draft["items"])} podání</span>
    <span :if={@draft != @initial} role="status" class="text-amber-800">Neuložené změny</span>
    <button
      type="button"
      phx-click="undo"
      phx-target={@myself}
      disabled={@history == []}
      class="text-tertiary-600 underline disabled:opacity-40"
    >Vrátit poslední změnu</button>
  </div>
  <button
    id={"#{@id}-toggle-breakfasts"}
    type="button"
    phx-click="toggle_breakfasts"
    phx-target={@myself}
    role="switch"
    aria-checked={to_string(@show_breakfasts)}
    class="text-sm text-tertiary-600 underline"
  >{if @show_breakfasts, do: "Skrýt snídaně", else: "Zobrazit a upravit snídaně"}</button>
  <p :if={not @show_breakfasts} class="text-sm text-primary-400">
    Snídaně jsou skryté, ale zůstávají v menu i ve výpočtu surovin. Nové snídaně se vyplňují snídaňovým bufetem.
  </p>
  <p
    :if={not @show_breakfasts and breakfast_attention?(@draft["items"], @catalog)}
    class="text-sm text-amber-800"
  >
    Některé snídaně vyžadují kontrolu. Zapněte jejich zobrazení a zkontrolujte vybrané recepty.
  </p>
  <div class="grid items-start gap-5 lg:grid-cols-[minmax(0,1fr)_22rem]">
    <.form
      for={to_form(@draft, as: :editor)}
      id={"#{@id}-form"}
      phx-target={@myself}
      phx-change="validate"
      phx-submit="save"
      class="space-y-4"
    >
      <div
        :if={@mode == :variant}
        class="space-y-4 rounded-lg border border-secondary-200 bg-white p-4"
      >
        <.input
          id="editor-name"
          name="editor[name]"
          value={@draft["name"]}
          label="Název menu"
          required
        />
        <div class="grid gap-3 sm:grid-cols-2">
          <.input
            id="editor-days"
            name="editor[days]"
            value={@draft["days"]}
            type="number"
            min="1"
            max="366"
            label="Počet dnů včetně příjezdu a odjezdu"
            required
          />
          <.input
            id="editor-meal_plan"
            name="editor[meal_plan]"
            value={@draft["meal_plan"]}
            type="select"
            label="Penze"
            options={[{"Plná penze", "full_board"}, {"Polopenze", "half_board"}]}
          />
          <.input
            id="editor-first_meal"
            name="editor[first_meal]"
            value={@draft["first_meal"]}
            type="select"
            label="První jídlo"
            options={meal_options()}
          />
          <.input
            id="editor-last_meal"
            name="editor[last_meal]"
            value={@draft["last_meal"]}
            type="select"
            label="Poslední jídlo"
            options={meal_options()}
          />
        </div>
        <button
          id="build-menu-variant"
          type="button"
          phx-click="build"
          phx-target={@myself}
          class="rounded-lg border px-4 py-2 text-tertiary-600"
        >Aktualizovat rozpis podle nastavení</button>
        <p class="text-sm text-primary-400">
          Shodná podání zachovají recepty. Před odstraněním vyplněných podání uvidíte dopad. Menu lze uložit i rozpracované.
        </p>
      </div>
      <div class="space-y-4">
        <fieldset
          :for={{item, index} <- Enum.with_index(@draft["items"])}
          :if={@show_breakfasts or item["meal_type"] != "breakfast"}
          id={"menu-slot-#{index}"}
          class={[
            "rounded-lg border bg-white p-4",
            if(@active == index,
              do: "border-tertiary-500 ring-2 ring-tertiary-100",
              else: "border-secondary-200"
            )
          ]}
        >
          <legend class="px-2 font-semibold">
            Den {item["day_number"]} · {meal_label(item["meal_type"])}
          </legend>
          <div
            data-slot-index={index}
            data-role="main"
            class="rounded-lg border border-dashed border-secondary-300 p-3"
          >
            <p class="text-xs uppercase text-primary-400">
              Hlavní recept / bufet · přetažením nahradíte
            </p>
            <p class="my-2 font-semibold">{recipe_name(@catalog, item["recipe_id"])}</p>
            <p
              :if={@catalog[item["recipe_id"]] && @catalog[item["recipe_id"]].archived_at}
              class="text-sm text-amber-800"
            >
              Archivovaný recept — před novým přiřazením ho nahraďte.
            </p>
            <button
              type="button"
              phx-click="activate"
              phx-target={@myself}
              phx-value-index={index}
              phx-value-role="main"
              class="mr-4 text-tertiary-600 underline"
            >{if item["recipe_id"], do: "Vyměnit recept", else: "Přidat hlavní recept"}</button>
            <button
              :if={item["recipe_id"]}
              type="button"
              phx-click="remove_recipe"
              phx-target={@myself}
              phx-value-index={index}
              phx-value-id={item["recipe_id"]}
              class="text-primary-400 underline"
            >Odebrat hlavní recept</button>
          </div>
          <div
            data-slot-index={index}
            data-role="extra"
            class="mt-3 space-y-2 rounded-lg border border-dashed border-secondary-300 p-3"
          >
            <p class="text-xs uppercase text-primary-400">Doplňky · přetažením přidáte další</p>
            <div
              :for={{id, position} <- Enum.with_index(item["supplement_recipe_ids"])}
              class="flex flex-wrap items-center gap-3 rounded bg-secondary-50 p-2 text-sm"
            >
              <span class="mr-auto">{position + 1}. {recipe_name(@catalog, id)}{if @catalog[id] &&
                                                                                     @catalog[id].archived_at,
                                                                                   do:
                                                                                     " (archivovaný)"}</span>
              <button
                type="button"
                phx-click="reorder"
                phx-target={@myself}
                phx-value-index={index}
                phx-value-id={id}
                phx-value-direction="up"
                disabled={position == 0}
                aria-label={"Posunout #{recipe_name(@catalog, id)} nahoru"}
                class="disabled:opacity-30"
              >↑</button>
              <button
                type="button"
                phx-click="reorder"
                phx-target={@myself}
                phx-value-index={index}
                phx-value-id={id}
                phx-value-direction="down"
                disabled={position == length(item["supplement_recipe_ids"]) - 1}
                aria-label={"Posunout #{recipe_name(@catalog, id)} dolů"}
                class="disabled:opacity-30"
              >↓</button>
              <button
                type="button"
                phx-click="remove_recipe"
                phx-target={@myself}
                phx-value-index={index}
                phx-value-id={id}
                class="text-tertiary-600 underline"
              >Odebrat</button>
            </div>
            <button
              type="button"
              phx-click="activate"
              phx-target={@myself}
              phx-value-index={index}
              phx-value-role="extra"
              class="text-tertiary-600 underline"
            >Přidat doplněk</button>
          </div>
          <.input
            id={"editor-note-#{index}"}
            name={"editor[items][#{index}][note]"}
            value={item["note"]}
            type="textarea"
            label="Poznámka k podání (neovlivňuje spotřebu)"
            rows="2"
            phx-debounce="300"
          />
          <div
            :if={
              legacy_source(assigns, item) && MenuRecipes.legacy?(legacy_source(assigns, item))
            }
            class="mt-3 rounded-lg bg-amber-50 p-3 text-sm text-amber-900"
          >
            <p class="font-semibold">Původní text ke kontrole</p>
            <p class="my-2 whitespace-pre-line">
              {CozyCheckout.Meals.MenuPlanning.menu_text(
                legacy_source(assigns, item).menu_text,
                legacy_source(assigns, item).supplements
              )}
            </p>
            <p class="mb-2">
              Zkontrolujte i přílohy a suroviny. Vyberte správné recepty nebo původní položky výslovně odstraňte potvrzením níže.
            </p>
            <.input
              id={"editor-review-#{index}"}
              name={"editor[items][#{index}][reviewed]"}
              checked={truthy?(item["reviewed"])}
              type="checkbox"
              label="Výběr jsem zkontroloval/a; nevybrané původní položky odstranit"
            />
          </div>
        </fieldset>
      </div>
      <div
        :if={
          @mode == :variant and
            (@show_breakfasts or Enum.any?(@draft["items"], &(&1["meal_type"] != "breakfast")))
        }
        class="space-y-3 rounded-lg border border-secondary-200 bg-white p-4"
      >
        <p class="font-semibold">Kopie a přesun aktivního podání (zvýrazněné výše)</p>
        <div class="grid grid-cols-2 gap-3">
          <.input
            id="editor-transfer_day"
            name="editor[transfer_day]"
            value={@transfer_day}
            type="number"
            min="1"
            max={@draft["days"]}
            label="Cílový den"
          />
          <.input
            id="editor-transfer_type"
            name="editor[transfer_type]"
            value={@transfer_type}
            type="select"
            label="Cílové podání"
            options={
              Enum.reject(meal_options(), fn {_, type} ->
                not @show_breakfasts and type == "breakfast"
              end)
            }
          />
        </div>
        <div class="flex flex-wrap gap-3 text-sm text-tertiary-600">
          <button type="button" phx-click="copy_service" phx-target={@myself} class="underline">Kopírovat podání</button>
          <button type="button" phx-click="move_service" phx-target={@myself} class="underline">Přesunout podání</button>
          <button type="button" phx-click="copy_day" phx-target={@myself} class="underline">Kopírovat celý den do cílového dne</button>
          <button
            :if={@show_breakfasts}
            type="button"
            phx-click="breakfasts"
            phx-target={@myself}
            class="underline"
          >Bufet aktivní snídaně na všechny snídaně</button>
        </div>
      </div>
      <div class="flex flex-wrap items-center justify-end gap-4">
        <.link navigate={@return_to} data-menu-cancel class="text-primary-400 underline">Zrušit</.link>
        <.button id="save-menu-variant" type="submit" phx-disable-with="Ukládám…">Uložit menu</.button>
      </div>
    </.form>
    <aside
      :if={@show_breakfasts or Enum.any?(@draft["items"], &(&1["meal_type"] != "breakfast"))}
      data-menu-library
      id={"#{@id}-library"}
      class={[
        "space-y-4 rounded-lg border border-secondary-200 bg-white p-4 shadow-lg lg:sticky lg:top-4 lg:max-h-[85vh] lg:overflow-y-auto",
        if(@library_open,
          do: "fixed inset-3 z-40 overflow-y-auto lg:inset-auto lg:z-auto",
          else: "hidden lg:block"
        )
      ]}
    >
      <div class="flex items-center justify-between">
        <h2 class="font-semibold">Knihovna receptů</h2><button
          type="button"
          phx-click="close_library"
          phx-target={@myself}
          class="text-tertiary-600 underline lg:hidden"
        >Zavřít</button>
      </div>
      <p class="text-sm">
        Den {Enum.at(@draft["items"], @active, %{})["day_number"]} · {meal_label(
          Enum.at(@draft["items"], @active, %{})["meal_type"]
        )} · {if @role == "main", do: "nahradit hlavní recept", else: "přidat doplněk"}
      </p>
      <.form for={%{}} id={"#{@id}-search"} phx-change="search" phx-target={@myself}>
        <input
          type="search"
          name="recipe_search"
          value={@search}
          phx-debounce="200"
          placeholder="Hledat recept…"
          aria-label="Hledat recept"
          class={field_class()}
        />
      </.form>
      <p :if={@choices == []} class="text-sm text-primary-400">Žádný recept nenalezen.</p>
      <article
        :for={recipe <- @choices}
        id={"editor-recipe-#{recipe.id}"}
        draggable="true"
        data-recipe-id={recipe.id}
        class="rounded-lg border border-secondary-200 p-3"
      >
        <h3 class="font-semibold">{recipe.name}</h3>
        <div class="mt-2 flex flex-wrap gap-3 text-sm">
          <button
            type="button"
            phx-click="select_recipe"
            phx-target={@myself}
            phx-value-id={recipe.id}
            class="text-tertiary-600 underline"
          >{if @role == "main", do: "Jako hlavní recept", else: "Přidat doplněk"}</button>
          <button
            type="button"
            phx-click="details"
            phx-target={@myself}
            phx-value-id={recipe.id}
            class="text-primary-400 underline"
          >Suroviny</button>
        </div>
      </article>
      <button
        :if={@more?}
        type="button"
        phx-click="more"
        phx-target={@myself}
        phx-disable-with="Načítám…"
        class="rounded-lg border px-4 py-2 text-tertiary-600"
      >Další recepty</button>
    </aside>
  </div>
  <.modal
    :if={@pending}
    id="menu-impact"
    show
    on_cancel={JS.push("cancel_pending", target: @myself)}
  >
    <h2 id="menu-impact-title" class="text-xl font-semibold">Potvrdit změnu rozpisu</h2>
    <p class="my-3">Následující vyplněná podání se odstraní nebo přepíšou:</p>
    <ul class="list-inside list-disc">
      <li :for={item <- @pending.affected}>
        Den {item["day_number"]} · {meal_label(item["meal_type"])} · {Enum.map_join(
          selected_ids(item),
          ", ",
          &recipe_name(@catalog, &1)
        )}{if item["note"] not in [nil, ""], do: " · poznámka"} → {impact_result(
          @pending,
          item,
          @catalog
        )}
      </li>
    </ul>
    <p class="my-3 text-sm">
      Změna se uloží až tlačítkem Uložit menu. Podání dostupná v cílovém dni určují rozsah kopie.
    </p>
    <div class="mt-4 flex gap-4">
      <button
        type="button"
        phx-click="confirm"
        phx-target={@myself}
        class="rounded-lg bg-primary-500 px-4 py-2 text-white"
      >Potvrdit změnu</button><button
        type="button"
        phx-click="cancel_pending"
        phx-target={@myself}
        class="underline"
      >Ponechat rozpis</button>
    </div>
  </.modal>
  <.modal
    :if={@details}
    id="menu-recipe-details"
    show
    on_cancel={JS.push("close_details", target: @myself)}
  >
    <h2 class="text-xl font-semibold">{@details.name}</h2>
    <p class="my-3">Základní dávka: {Decimal.to_string(@details.base_servings, :normal)} porcí</p>
    <ul class="list-inside list-disc">
      <li :for={line <- @details.lines}>
        {line.ingredient.name} · {Recipes.format_quantity(line.quantity, line.unit)}
      </li>
    </ul>
    <p class="my-3 whitespace-pre-line text-sm">{@details.notes}</p>
    <button
      type="button"
      phx-click="close_details"
      phx-target={@myself}
      class="mt-4 text-tertiary-600 underline"
    >Zavřít suroviny</button>
  </.modal>
</div>
