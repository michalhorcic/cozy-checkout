<div
  id={@id}
  phx-hook="MenuEditor"
  phx-target={@myself}
  data-dirty={to_string(@draft != @initial)}
  data-library-open={to_string(@library_open)}
  class="space-y-2"
>
  <p :if={@error} role="alert" class="rounded-lg bg-red-50 p-3 text-sm text-red-800">{@error}</p>
  <div class="flex flex-wrap items-center gap-x-3 gap-y-1 rounded-lg bg-secondary-50 px-3 py-1 text-sm">
    <span class="font-semibold">Vyplněno {Enum.count(
      @draft["items"],
      &(&1["recipe_id"] not in [nil, ""])
    )}/{length(@draft["items"])} podání</span>
    <span :if={@draft != @initial} role="status" class="text-xs text-amber-800">Neuložené změny</span>
    <div class="ml-auto flex items-center gap-1">
      <span class="text-xs text-primary-400">{if @show_breakfasts,
        do: "Snídaně zobrazené",
        else: "Snídaně skryté"}</span>
      <.icon_action
        id={"#{@id}-toggle-breakfasts"}
        icon="hero-sun"
        label={if @show_breakfasts, do: "Skrýt snídaně", else: "Zobrazit a upravit snídaně"}
        phx-click="toggle_breakfasts"
        phx-target={@myself}
        role="switch"
        aria-checked={to_string(@show_breakfasts)}
        class={if @show_breakfasts, do: "bg-tertiary-100", else: ""}
      />
      <.icon_action
        icon="hero-arrow-uturn-left"
        label="Vrátit poslední změnu"
        phx-click="undo"
        phx-target={@myself}
        disabled={@history == []}
      />
    </div>
  </div>
  <p
    :if={not @show_breakfasts and breakfast_attention?(@draft["items"], @catalog)}
    class="text-sm text-amber-800"
  >
    Některé snídaně vyžadují kontrolu. Zapněte jejich zobrazení a zkontrolujte vybrané recepty.
  </p>
  <div class="grid items-start gap-3 lg:grid-cols-[minmax(0,1fr)_20rem]">
    <.form
      for={to_form(@draft, as: :editor)}
      id={"#{@id}-form"}
      phx-target={@myself}
      phx-change="validate"
      phx-submit="save"
      class="space-y-2"
    >
      <div
        :if={@mode == :variant}
        class="space-y-2 rounded-lg border border-secondary-200 bg-white p-3 [&_label]:text-xs [&_label]:leading-4"
      >
        <div class="flex items-end gap-2">
          <div class="min-w-0 flex-1">
            <.input
              id="editor-name"
              name="editor[name]"
              value={@draft["name"]}
              label="Název menu"
              class={compact_field_class()}
              required
            />
          </div>
          <.icon_action
            id="build-menu-variant"
            icon="hero-arrow-path"
            label="Aktualizovat rozpis podle nastavení"
            phx-click="build"
            phx-target={@myself}
          />
        </div>
        <div class="grid grid-cols-2 gap-2 xl:grid-cols-4">
          <.input
            id="editor-days"
            name="editor[days]"
            value={@draft["days"]}
            type="number"
            min="1"
            max="366"
            label="Počet dnů"
            class={compact_field_class()}
            required
          />
          <.input
            id="editor-meal_plan"
            name="editor[meal_plan]"
            value={@draft["meal_plan"]}
            type="select"
            label="Penze"
            class={compact_field_class()}
            options={[{"Plná penze", "full_board"}, {"Polopenze", "half_board"}]}
          />
          <.input
            id="editor-first_meal"
            name="editor[first_meal]"
            value={@draft["first_meal"]}
            type="select"
            label="První jídlo"
            class={compact_field_class()}
            options={meal_options()}
          />
          <.input
            id="editor-last_meal"
            name="editor[last_meal]"
            value={@draft["last_meal"]}
            type="select"
            label="Poslední jídlo"
            class={compact_field_class()}
            options={meal_options()}
          />
        </div>
      </div>
      <div class="space-y-2">
        <fieldset
          :for={{item, index} <- Enum.with_index(@draft["items"])}
          :if={@show_breakfasts or item["meal_type"] != "breakfast"}
          id={"menu-slot-#{index}"}
          class={[
            "min-w-0 rounded-lg border bg-white px-2 pb-2",
            if(@active == index,
              do: "border-tertiary-500 ring-1 ring-tertiary-100",
              else: "border-secondary-200"
            )
          ]}
        >
          <legend class="px-1 text-xs font-semibold text-primary-400">
            Den {item["day_number"]} · {meal_label(item["meal_type"])}
          </legend>
          <div
            data-slot-index={index}
            data-role="main"
            title="Hlavní recept / bufet · přetažením nahradíte"
            aria-label="Hlavní recept / bufet · přetažením nahradíte"
            class="flex min-w-0 items-center gap-1 rounded-md border border-dashed border-secondary-200 px-2 py-0.5"
          >
            <span class="hidden text-[10px] uppercase text-primary-400 sm:inline">Hlavní</span>
            <p
              class="min-w-0 flex-1 break-words text-sm font-semibold leading-5"
              title={recipe_name(@catalog, item["recipe_id"])}
            >
              {recipe_name(@catalog, item["recipe_id"])}
            </p>
            <.icon
              :if={@catalog[item["recipe_id"]] && @catalog[item["recipe_id"]].archived_at}
              name="hero-exclamation-triangle"
              class="h-4 w-4 shrink-0 text-amber-700"
            />
            <.icon_action
              icon={if item["recipe_id"], do: "hero-pencil-square", else: "hero-plus"}
              label={if item["recipe_id"], do: "Vyměnit recept", else: "Přidat hlavní recept"}
              phx-click="activate"
              phx-target={@myself}
              phx-value-index={index}
              phx-value-role="main"
            />
            <.icon_action
              :if={item["recipe_id"]}
              icon="hero-x-mark"
              label="Odebrat hlavní recept"
              phx-click="remove_recipe"
              phx-target={@myself}
              phx-value-index={index}
              phx-value-id={item["recipe_id"]}
            />
            <.icon_action
              icon="hero-squares-plus"
              label="Přidat doplněk"
              phx-click="activate"
              phx-target={@myself}
              phx-value-index={index}
              phx-value-role="extra"
            />
            <.icon_action
              icon="hero-chat-bubble-left-ellipsis"
              label={
                if MapSet.member?(@open_notes, coordinate(item)),
                  do: "Skrýt poznámku",
                  else:
                    if(item["note"] in [nil, ""],
                      do: "Přidat poznámku",
                      else: "Zobrazit poznámku"
                    )
              }
              phx-click="toggle_note"
              phx-target={@myself}
              phx-value-index={index}
              aria-expanded={to_string(MapSet.member?(@open_notes, coordinate(item)))}
              aria-controls={"editor-note-panel-#{index}"}
              class={
                if item["note"] not in [nil, ""], do: "bg-tertiary-50 text-tertiary-800", else: ""
              }
            />
          </div>
          <p
            :if={@catalog[item["recipe_id"]] && @catalog[item["recipe_id"]].archived_at}
            class="mt-1 text-xs text-amber-800"
          >
            Archivovaný recept — před novým přiřazením ho nahraďte.
          </p>
          <div
            data-slot-index={index}
            data-role="extra"
            title="Doplňky · přetažením přidáte další"
            aria-label="Doplňky · přetažením přidáte další"
            class="mt-1 space-y-0.5 rounded-md border border-dashed border-secondary-200 px-2 py-1"
          >
            <p
              :if={item["supplement_recipe_ids"] == []}
              class="text-xs leading-4 text-primary-400"
            >
              Doplňky · přetažením nebo tlačítkem +
            </p>
            <div
              :for={{id, position} <- Enum.with_index(item["supplement_recipe_ids"])}
              class="flex min-w-0 items-center gap-1 text-sm"
            >
              <span class="min-w-0 flex-1 break-words leading-5" title={recipe_name(@catalog, id)}><span class="text-xs text-primary-400">{position +
                1}.</span> {recipe_name(@catalog, id)}{if @catalog[id] && @catalog[id].archived_at,
                do: " (archivovaný)"}</span>
              <.icon_action
                icon="hero-chevron-up"
                label={"Posunout #{recipe_name(@catalog, id)} nahoru"}
                phx-click="reorder"
                phx-target={@myself}
                phx-value-index={index}
                phx-value-id={id}
                phx-value-direction="up"
                disabled={position == 0}
              />
              <.icon_action
                icon="hero-chevron-down"
                label={"Posunout #{recipe_name(@catalog, id)} dolů"}
                phx-click="reorder"
                phx-target={@myself}
                phx-value-index={index}
                phx-value-id={id}
                phx-value-direction="down"
                disabled={position == length(item["supplement_recipe_ids"]) - 1}
              />
              <.icon_action
                icon="hero-x-mark"
                label={"Odebrat doplněk #{recipe_name(@catalog, id)}"}
                phx-click="remove_recipe"
                phx-target={@myself}
                phx-value-index={index}
                phx-value-id={id}
              />
            </div>
          </div>
          <div
            :if={MapSet.member?(@open_notes, coordinate(item))}
            id={"editor-note-panel-#{index}"}
            class="mt-2 [&_label]:text-xs"
          >
            <.input
              id={"editor-note-#{index}"}
              name={"editor[items][#{index}][note]"}
              value={item["note"]}
              type="textarea"
              label="Poznámka k podání (neovlivňuje spotřebu)"
              rows="2"
              class={compact_field_class()}
            />
          </div>
          <div
            :if={
              legacy_source(assigns, item) && MenuRecipes.legacy?(legacy_source(assigns, item))
            }
            class="mt-2 rounded-md bg-amber-50 p-2 text-xs text-amber-900"
          >
            <p class="font-semibold">Původní text ke kontrole</p>
            <p class="my-1 whitespace-pre-line">
              {CozyCheckout.Meals.MenuPlanning.menu_text(
                legacy_source(assigns, item).menu_text,
                legacy_source(assigns, item).supplements
              )}
            </p>
            <p class="mb-1">
              Zkontrolujte i přílohy a suroviny; potvrzením odstraníte nevybrané původní položky.
            </p>
            <.input
              id={"editor-review-#{index}"}
              name={"editor[items][#{index}][reviewed]"}
              checked={truthy?(item["reviewed"])}
              type="checkbox"
              label="Výběr jsem zkontroloval/a; nevybrané původní položky odstranit"
            />
          </div>
        </fieldset>
      </div>
      <div
        :if={
          @mode == :variant and
            (@show_breakfasts or Enum.any?(@draft["items"], &(&1["meal_type"] != "breakfast")))
        }
        class="flex flex-wrap items-end gap-2 rounded-lg border border-secondary-200 bg-white p-2 [&_label]:text-xs [&_label]:leading-4"
      >
        <div class="w-20">
          <.input
            id="editor-transfer_day"
            name="editor[transfer_day]"
            value={@transfer_day}
            type="number"
            min="1"
            max={@draft["days"]}
            label="Cílový den"
            class={compact_field_class()}
          />
        </div>
        <div class="min-w-28 flex-1">
          <.input
            id="editor-transfer_type"
            name="editor[transfer_type]"
            value={@transfer_type}
            type="select"
            label="Cílové podání"
            class={compact_field_class()}
            options={
              Enum.reject(meal_options(), fn {_, type} ->
                not @show_breakfasts and type == "breakfast"
              end)
            }
          />
        </div>
        <div class="flex gap-0.5" aria-label="Kopie a přesun aktivního podání">
          <.icon_action
            icon="hero-document-duplicate"
            label="Kopírovat aktivní podání"
            phx-click="copy_service"
            phx-target={@myself}
          />
          <.icon_action
            icon="hero-arrows-right-left"
            label="Přesunout aktivní podání"
            phx-click="move_service"
            phx-target={@myself}
          />
          <.icon_action
            icon="hero-clipboard-document"
            label="Kopírovat celý den do cílového dne"
            phx-click="copy_day"
            phx-target={@myself}
          />
          <.icon_action
            :if={@show_breakfasts}
            icon="hero-sun"
            label="Bufet aktivní snídaně na všechny snídaně"
            phx-click="breakfasts"
            phx-target={@myself}
          />
        </div>
      </div>
      <div class="flex items-center justify-end gap-2">
        <.link
          navigate={@return_to}
          data-menu-cancel
          title="Zrušit neuložené změny"
          aria-label="Zrušit neuložené změny"
          class="inline-flex min-h-10 min-w-10 items-center justify-center rounded-md p-2 text-primary-400 hover:bg-secondary-50"
        ><.icon name="hero-x-mark" class="h-5 w-5" /></.link>
        <.button
          id="save-menu-variant"
          type="submit"
          title="Uložit menu"
          aria-label="Uložit menu"
          phx-disable-with="Ukládám…"
        ><.icon name="hero-check" class="h-5 w-5" /></.button>
      </div>
    </.form>
    <aside
      :if={@show_breakfasts or Enum.any?(@draft["items"], &(&1["meal_type"] != "breakfast"))}
      data-menu-library
      id={"#{@id}-library"}
      class={[
        "space-y-2 rounded-lg border border-secondary-200 bg-white p-3 shadow-sm lg:sticky lg:top-4 lg:max-h-[85vh] lg:overflow-y-auto",
        if(@library_open,
          do: "fixed inset-3 z-40 overflow-y-auto lg:inset-auto lg:z-auto",
          else: "hidden lg:block"
        )
      ]}
    >
      <div class="flex items-center justify-between">
        <h2 class="text-sm font-semibold">Knihovna receptů</h2><.icon_action
          icon="hero-x-mark"
          label="Zavřít knihovnu"
          phx-click="close_library"
          phx-target={@myself}
          class="lg:hidden"
        />
      </div>
      <p class="text-xs text-primary-400">
        Den {Enum.at(@draft["items"], @active, %{})["day_number"]} · {meal_label(
          Enum.at(@draft["items"], @active, %{})["meal_type"]
        )} · {if @role == "main", do: "nahradit hlavní recept", else: "přidat doplněk"}
      </p>
      <.form for={%{}} id={"#{@id}-search"} phx-change="search" phx-target={@myself}>
        <input
          type="search"
          name="recipe_search"
          value={@search}
          phx-debounce="200"
          placeholder="Hledat recept…"
          aria-label="Hledat recept"
          class={compact_field_class()}
        />
      </.form>
      <p :if={@choices == []} class="text-sm text-primary-400">Žádný recept nenalezen.</p>
      <article
        :for={recipe <- @choices}
        id={"editor-recipe-#{recipe.id}"}
        draggable="true"
        data-recipe-id={recipe.id}
        class="flex min-w-0 items-center gap-1 rounded-md border border-secondary-200 px-2 py-1"
      >
        <h3 class="min-w-0 flex-1 break-words text-sm font-medium leading-5" title={recipe.name}>
          {recipe.name}
        </h3>
        <.icon_action
          icon={if @role == "main", do: "hero-check-circle", else: "hero-plus-circle"}
          label={if @role == "main", do: "Použít jako hlavní recept", else: "Přidat jako doplněk"}
          phx-click="select_recipe"
          phx-target={@myself}
          phx-value-id={recipe.id}
        />
        <.icon_action
          icon="hero-list-bullet"
          label={"Suroviny: #{recipe.name}"}
          phx-click="details"
          phx-target={@myself}
          phx-value-id={recipe.id}
        />
      </article>
      <.icon_action
        :if={@more?}
        icon="hero-chevron-double-down"
        label="Další recepty"
        phx-click="more"
        phx-target={@myself}
        phx-disable-with="Načítám…"
      />
    </aside>
  </div>
  <.modal
    :if={@pending}
    id="menu-impact"
    show
    on_cancel={JS.push("cancel_pending", target: @myself)}
  >
    <h2 id="menu-impact-title" class="text-xl font-semibold">Potvrdit změnu rozpisu</h2>
    <p class="my-3">Následující vyplněná podání se odstraní nebo přepíšou:</p>
    <ul class="list-inside list-disc">
      <li :for={item <- @pending.affected}>
        Den {item["day_number"]} · {meal_label(item["meal_type"])} · {Enum.map_join(
          selected_ids(item),
          ", ",
          &recipe_name(@catalog, &1)
        )}{if item["note"] not in [nil, ""], do: " · poznámka"} → {impact_result(
          @pending,
          item,
          @catalog
        )}
      </li>
    </ul>
    <p class="my-3 text-sm">
      Změna se uloží až tlačítkem Uložit menu. Podání dostupná v cílovém dni určují rozsah kopie.
    </p>
    <div class="mt-4 flex gap-4">
      <button
        type="button"
        phx-click="confirm"
        phx-target={@myself}
        class="rounded-lg bg-primary-500 px-4 py-2 text-white"
      >Potvrdit změnu</button><button
        type="button"
        phx-click="cancel_pending"
        phx-target={@myself}
        class="underline"
      >Ponechat rozpis</button>
    </div>
  </.modal>
  <.modal
    :if={@details}
    id="menu-recipe-details"
    show
    on_cancel={JS.push("close_details", target: @myself)}
  >
    <h2 class="text-xl font-semibold">{@details.name}</h2>
    <p class="my-3">Základní dávka: {Decimal.to_string(@details.base_servings, :normal)} porcí</p>
    <ul class="list-inside list-disc">
      <li :for={line <- @details.lines}>
        {line.ingredient.name} · {Recipes.format_quantity(line.quantity, line.unit)}
      </li>
    </ul>
    <p class="my-3 whitespace-pre-line text-sm">{@details.notes}</p>
    <button
      type="button"
      phx-click="close_details"
      phx-target={@myself}
      class="mt-4 text-tertiary-600 underline"
    >Zavřít suroviny</button>
  </.modal>
</div>
