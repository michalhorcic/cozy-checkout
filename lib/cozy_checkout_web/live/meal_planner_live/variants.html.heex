<Layouts.app
  food_section={:variants}
  food_context={@food_context}
  flash={@flash}
  show_header={false}
  main_class=""
  content_class=""
>
  <div class="w-full space-y-5">
    <.kitchen_header
      title={
        if @variant,
          do: if(@variant.id, do: "Upravit menu", else: "Nové menu"),
          else: "Menu z receptů"
      }
      subtitle="Sestavy jídel pro celý pobyt. Názvy a suroviny se načítají z aktuálních receptů."
    >
      <:actions>
        <.link
          :if={is_nil(@variant)}
          patch={
            CozyCheckoutWeb.FoodNavigation.with_context(
              ~p"/admin/meal-planner/variants/new",
              @food_context
            )
          }
          id="new-menu-variant"
          class="rounded-lg bg-primary-500 px-4 py-2 text-white"
        >Nové menu</.link>
      </:actions>
    </.kitchen_header>
    <.live_component
      :if={@variant}
      module={CozyCheckoutWeb.MealPlannerLive.MenuEditorComponent}
      id={"menu-editor-#{@variant.id || "new"}"}
      mode={:variant}
      record={@variant}
      focus_item={@focus_item}
      return_to={CozyCheckoutWeb.FoodNavigation.path(:variants, @food_context)}
    />
    <section :if={is_nil(@variant)} class="space-y-3 rounded-lg bg-white p-4 shadow">
      <.form
        for={to_form(@filters, as: :filters)}
        id="menu-filters"
        phx-change="filter"
        class="grid gap-3 sm:grid-cols-4"
      >
        <.input
          name="filters[search]"
          value={@filters["search"]}
          type="search"
          label="Název menu nebo receptu"
          phx-debounce="200"
        />
        <.input
          name="filters[days]"
          value={@filters["days"]}
          type="number"
          min="1"
          max="366"
          label="Počet dnů"
        />
        <.input
          name="filters[plan]"
          value={@filters["plan"]}
          type="select"
          label="Penze"
          options={[{"Všechny", ""}, {"Plná penze", "full_board"}, {"Polopenze", "half_board"}]}
        />
        <.input
          name="filters[state]"
          value={@filters["state"]}
          type="select"
          label="Stav"
          options={[
            {"Všechna menu", ""},
            {"Připravená", "ready"},
            {"Rozpracovaná", "draft"},
            {"K dořešení", "review"}
          ]}
        />
      </.form>
      <button
        id="menu-overview-toggle-breakfasts"
        type="button"
        phx-click="toggle_breakfasts"
        role="switch"
        aria-checked={to_string(@show_breakfasts)}
        class="text-sm text-tertiary-600 underline"
      >{if @show_breakfasts, do: "Skrýt snídaně v náhledech", else: "Zobrazit snídaně v náhledech"}</button>
      <div id="menu-variants" class="divide-y divide-secondary-200">
        <p :if={@variants == []} id="menu-variants-empty" class="py-5 text-primary-400">
          Žádné menu neodpovídá výběru.
        </p>
        <article :for={variant <- @variants} id={"menu-variant-#{variant.id}"} class="py-2.5">
          <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1">
            <div class="min-w-0 basis-full sm:flex-1 sm:basis-0">
              <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                <h2 class="min-w-0 break-words text-sm font-semibold">{variant.name}</h2>
                <span class="text-xs text-primary-400">{MenuRecipes.readiness(variant).label}</span>
              </div>
            </div>
            <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-tertiary-600">
              <.link
                patch={
                  CozyCheckoutWeb.FoodNavigation.with_context(
                    ~p"/admin/meal-planner/variants/#{variant.id}/edit",
                    @food_context
                  )
                }
                class="inline-flex min-h-8 items-center underline"
              >Upravit</.link>
              <button
                type="button"
                phx-click="assign"
                phx-value-id={variant.id}
                disabled={not MenuRecipes.readiness(variant).ready?}
                class="min-h-8 underline disabled:opacity-40"
              >Přiřadit pobytu</button>
              <details>
                <summary class="cursor-pointer py-1.5 text-primary-400">Další</summary>
                <button
                  type="button"
                  phx-click="duplicate"
                  phx-value-id={variant.id}
                  class="block p-2 underline"
                >Duplikovat</button>
                <button
                  type="button"
                  phx-click="delete"
                  phx-value-id={variant.id}
                  data-confirm="Archivovat menu? Přiřazené pobyty zůstanou zachované."
                  class="p-2 underline"
                >Archivovat</button>
              </details>
            </div>
          </div>
          <details id={"menu-preview-#{variant.id}"} phx-hook="MenuPreview">
            <summary class="w-fit cursor-pointer py-1 text-xs text-tertiary-600 underline">
              Obsah menu
            </summary>
            <div class="mt-2 max-h-80 space-y-3 overflow-y-auto rounded-lg border border-secondary-200 bg-secondary-50 p-4">
              <p class="text-sm text-primary-400">
                {variant.days} dnů · {meal_plan_label(variant.meal_plan)} · {meal_label(
                  variant.first_meal
                )} → {meal_label(variant.last_meal)}
              </p>
              <div
                :for={item <- sorted_items(variant)}
                :if={@show_breakfasts or item.meal_type != "breakfast"}
              >
                <p class="font-semibold">Den {item.day_number} · {meal_label(item.meal_type)}</p><p>
                  {MenuRecipes.display(item).main || "Chybí hlavní recept"}
                </p><p class="whitespace-pre-line text-sm">
                  {MenuRecipes.display(item).supplements}
                </p><p :if={item.note} class="text-sm text-primary-400">Poznámka: {item.note}</p><p
                  :if={MenuRecipes.legacy?(item)}
                  class="text-sm text-amber-800"
                >
                  Původní text čeká na kontrolu: {MenuRecipes.display(item).original}
                </p>
              </div>
            </div>
          </details>
        </article>
      </div>
      <details class="rounded-lg bg-secondary-50 p-4">
        <summary class="cursor-pointer text-sm text-primary-400">
          Import výchozích podkladů
        </summary><p class="my-3 text-sm">
          Existující menu ani zkontrolované položky se nepřepisují. Nejednoznačné názvy vyžadují kontrolu v editoru.
        </p><button
          id="import-menu-variants"
          type="button"
          phx-click="import_reference"
          phx-disable-with="Načítám…"
          class="text-tertiary-600 underline"
        >Přidat varianty z podkladové tabulky</button>
      </details>
    </section>
    <section :if={@assignment} id="menu-assignment" class="rounded-lg border bg-white p-5 shadow">
      <div class="flex justify-between gap-3">
        <h2 class="font-semibold">Přiřadit: {@assignment.name}</h2><button
          type="button"
          phx-click="close_assignment"
          class="underline"
        >Zavřít</button>
      </div>
      <.form for={%{}} id="assignment-search" phx-change="assignment_search">
        <input
          name="search"
          type="search"
          value={@assignment_search}
          phx-debounce="200"
          aria-label="Hledat vhodný pobyt"
          placeholder="Hledat vhodný pobyt…"
          class={field_class()}
        />
      </.form>
      <p class="my-3 text-sm text-primary-400">
        Nabízené pobyty mají shodnou délku, penzi a hranice. Před uložením uvidíte náhled a případné konflikty.
      </p>
      <div class="max-h-80 space-y-2 overflow-y-auto">
        <.link
          :for={booking <- assignment_matches(@assignment_options, @assignment_search)}
          navigate={
            CozyCheckoutWeb.FoodNavigation.with_context(
              "/admin/bookings/#{booking.id}/menu",
              Map.merge(@food_context, %{"booking" => booking.id, "variant" => @assignment.id})
            )
          }
          class="block rounded-lg border p-3 text-tertiary-600"
        >{booking.name}</.link>
      </div>
      <p :if={assignment_matches(@assignment_options, @assignment_search) == []}>
        Žádný vhodný pobyt.
      </p>
    </section>
  </div>
</Layouts.app>
