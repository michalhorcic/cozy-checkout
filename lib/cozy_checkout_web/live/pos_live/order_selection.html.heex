<Layouts.pos page_title={@page_title}>
  <div class="pos-workspace pos-order-selection min-h-screen bg-secondary-50 p-6">
    <p class="mb-3 text-sm font-semibold text-primary-400">Jindřichův dům</p>
    <!-- Header with Back Button -->
    <div class="pos-selection-heading mb-8">
      <button
        phx-click="back"
        class="mb-4 inline-flex items-center gap-2 text-primary-400 hover:text-primary-500 text-lg active:scale-95 transition-transform"
      >
        <.icon name="hero-arrow-left" class="w-6 h-6" />
        <span>Zpět na pobyty</span>
      </button>

      <h1 class="text-4xl font-bold text-primary-500 mb-2">
        {@booking.guest.name}
        <span :if={@booking.room_number} class="text-primary-300">
          - Pokoj {@booking.room_number}
        </span>
      </h1>
      <div class="flex items-center gap-4">
        <p class="text-lg text-primary-400">
          <%= if @orders == [] do %>
            Založte si účet
          <% else %>
            Vyberte svůj účet nebo založte nový
          <% end %>
        </p>
        <span
          :if={@total_guests > 1}
          class="px-3 py-1 bg-tertiary-100 text-tertiary-800 text-sm font-semibold rounded-full"
        >
          {length(@orders)} / {@total_guests} hostů s účtem
        </span>
      </div>
    </div>

    <!-- Orders Grid -->
    <div class="pos-account-grid grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-6">
      <button
        :for={order <- @orders}
        type="button"
        phx-click="select_order"
        phx-value-order-id={order.id}
        class={[
          "pos-account-tile text-left bg-white rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-200",
          "p-8 cursor-pointer active:scale-95 border-4 border-transparent hover:border-tertiary-500"
        ]}
      >
        <!-- Guest Name -->
        <span class="mb-4 block">
          <span class="block text-sm text-primary-300 mb-1">Host</span>
          <span class="pos-account-name block text-lg font-semibold text-primary-500">
            {if order.guest, do: order.guest.name, else: "Neznámý"}
          </span>
        </span>

        <!-- Order Number -->
        <span class="mb-4 block">
          <span class="block text-sm text-slate-500 mb-1">Číslo účtu</span>
          <span class="block text-xl font-bold text-slate-900">{order.order_number}</span>
        </span>

        <!-- Items Count -->
        <span class="mb-4 block">
          <span class="block text-sm text-slate-500 mb-1">Položky</span>
          <span class="block text-2xl font-bold text-tertiary-600">
            {Enum.count(Enum.filter(order.order_items, &is_nil(&1.deleted_at)))}
          </span>
        </span>

        <!-- Total Amount -->
        <span class="pos-account-total mb-4 block">
          <span class="block text-sm text-slate-500 mb-1">Celkem</span>
          <span class="block text-2xl font-bold text-success-dark">
            {format_currency(order.total_amount || Decimal.new("0"))}
          </span>
        </span>

        <!-- Status Badge -->
        <span class="mt-4 block pt-4 border-t border-slate-200">
          <span class={[
            "inline-block px-4 py-2 rounded-full text-sm font-semibold",
            if(order.status == "open",
              do: "bg-tertiary-100 text-tertiary-800",
              else: "bg-warning-light text-warning-dark"
            )
          ]}>
            {Map.get(
              %{
                "open" => "Otevřený",
                "paid" => "Zaplacený",
                "partially_paid" => "Částečně zaplacený",
                "cancelled" => "Zrušený"
              },
              order.status,
              order.status
            )}
          </span>
        </span>
      </button>
    </div>

    <!-- Create New Order Button -->
    <div class="max-w-md mx-auto">
      <button
        phx-click="create_new"
        class="w-full bg-success text-white text-xl font-bold py-6 px-8 rounded-2xl shadow-lg hover:shadow-xl active:scale-95 transition-all duration-200 hover:bg-success-dark"
      >
        <.icon name="hero-plus-circle" class="w-8 h-8 inline-block mr-3" /> Založit nový účet
      </button>
    </div>

    <!-- Guest Selection Modal -->
    <div
      :if={@show_guest_modal}
      class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4"
      phx-click="hide_guest_modal"
    >
      <div
        class="bg-white rounded-2xl shadow-2xl max-w-2xl w-full p-8"
        phx-click="stop_propagation"
      >
        <h2 class="text-3xl font-bold text-slate-900 mb-6">Vyberte hosta pro účet</h2>

        <div class="space-y-4">
          <button
            :for={booking_guest <- @booking_guests}
            phx-click="select_guest"
            phx-value-guest-id={booking_guest.guest_id}
            class={[
              "w-full bg-white border-2 rounded-xl p-6 text-left",
              "hover:border-tertiary-500 hover:bg-tertiary-50 transition-all duration-200",
              "active:scale-95 cursor-pointer",
              if(booking_guest.is_primary,
                do: "border-tertiary-500 bg-tertiary-50",
                else: "border-slate-200"
              )
            ]}
          >
            <div class="flex items-center justify-between">
              <div>
                <p class="text-xl font-bold text-slate-900">{booking_guest.guest.name}</p>
                <p :if={booking_guest.guest.email} class="text-sm text-slate-600 mt-1">
                  {booking_guest.guest.email}
                </p>
                <p :if={booking_guest.guest.phone} class="text-sm text-slate-600">
                  {booking_guest.guest.phone}
                </p>
              </div>
              <div>
                <span
                  :if={booking_guest.is_primary}
                  class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-tertiary-600 text-white"
                >
                  Hlavní host
                </span>
              </div>
            </div>
          </button>
        </div>

        <div class="mt-8 flex justify-end">
          <button
            phx-click="hide_guest_modal"
            class="px-6 py-3 bg-slate-200 hover:bg-slate-300 text-slate-800 font-semibold rounded-lg transition-colors"
          >
            Zrušit
          </button>
        </div>
      </div>
    </div>
  </div>
</Layouts.pos>
