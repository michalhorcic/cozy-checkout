<Layouts.pos page_title={@page_title}>
  <div class="pos-workspace pos-accounts min-h-screen bg-secondary-50 p-4">
    <header
      id="pos-welcome"
      aria-labelledby="pos-house-name"
      class="pos-welcome relative mb-3 isolate overflow-hidden rounded-xl border border-secondary-200 bg-secondary-50"
    >
      <img
        src={~p"/images/rano-nad-udolim.webp"}
        alt=""
        aria-hidden="true"
        width="1280"
        height="960"
        fetchpriority="high"
        class="pointer-events-none absolute inset-0 h-full w-full object-cover object-[center_60%] opacity-30"
      />
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 bg-linear-to-r from-secondary-50/95 via-secondary-50/80 to-secondary-50/40"
      >
      </div>
      <div class="relative flex min-h-20 flex-wrap items-center justify-between gap-3 px-4 py-3">
        <h1 id="pos-house-name" class="text-xl font-bold text-primary-500 sm:text-2xl">
          Jindřichův dům
        </h1>
        <div class="flex flex-wrap items-center gap-2">
          <button
            phx-click="show_quick_order_modal"
            id="pos-new-account"
            class="inline-flex min-h-11 items-center justify-center gap-2 rounded-lg bg-primary-500 px-3 text-sm font-semibold text-white transition-colors hover:bg-primary-600 active:scale-98"
          >
            <.icon name="hero-plus-circle" class="h-5 w-5" /> Nový účet
          </button>

          <!-- Obsluha Mode Toggle -->
          <div class="flex min-h-11 items-center gap-2 rounded-lg border border-secondary-200 bg-white/95 px-3">
            <span class={[
              "text-sm font-semibold transition-colors duration-200",
              (@service_mode && "text-gray-400") || "text-primary-600"
            ]}>
              Hosté
            </span>
            <button
              aria-label="Režim obsluhy"
              role="switch"
              aria-checked={to_string(@service_mode)}
              phx-click="toggle_service_mode"
              class={[
                "pos-service-switch relative inline-flex h-7 w-14 items-center rounded-full transition-colors duration-200 ease-in-out focus:outline-none focus:ring-2 focus:ring-purple-500 focus:ring-offset-2",
                (@service_mode && "bg-purple-600") || "bg-gray-300"
              ]}
            >
              <span class={[
                "inline-block h-5 w-5 transform rounded-full bg-white shadow-lg transition-transform duration-200 ease-in-out",
                (@service_mode && "translate-x-8") || "translate-x-1"
              ]}></span>
            </button>
            <span class={[
              "text-sm font-semibold transition-colors duration-200",
              (@service_mode && "text-purple-600") || "text-gray-400"
            ]}>
              Obsluha
            </span>
          </div>
          <.link
            href={~p"/admin"}
            class="inline-flex min-h-11 items-center gap-2 rounded-lg border border-secondary-200 bg-white/95 px-3 text-sm font-semibold text-primary-500 transition-colors hover:bg-secondary-100"
          >
            <.icon name="hero-lock-closed" class="w-5 h-5" /> Správa
          </.link>
        </div>
      </div>
    </header>

    <div class={[
      "grid items-start gap-5",
      !@service_mode && "lg:grid-cols-[minmax(0,1fr)_22rem]"
    ]}>
      <div class="min-w-0">
        <!-- Účty Section -->
        <div :if={@orders != []} class="mb-4">
          <h2 class="text-lg font-bold text-primary-500 mb-2">Účty</h2>
          <div class={[
            "pos-account-grid grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4",
            if(@service_mode,
              do: "lg:grid-cols-5 xl:grid-cols-6",
              else: "lg:grid-cols-3 xl:grid-cols-4 2xl:grid-cols-5"
            )
          ]}>
            <button
              :for={order <- @orders}
              type="button"
              id={"pos-order-#{order.id}"}
              phx-click="select_order"
              phx-value-order-id={order.id}
              class={[
                "pos-account-tile text-left bg-tertiary-50 rounded-xl shadow-lg hover:shadow-2xl transition-all duration-200",
                "p-4 cursor-pointer active:scale-95 border-2 border-tertiary-200 hover:border-tertiary-400",
                "min-h-[120px] flex flex-col justify-between"
              ]}
            >
              <span class="block">
                <span class="mb-3 block">
                  <.account_stamp stamp={AccountStamps.key(order)} />
                </span>
                <span class="pos-account-name font-heading block text-lg font-bold text-primary-500 mb-2 break-words leading-tight">
                  {Sales.get_order_display_name(order)}
                </span>
                <span class="block text-xs text-primary-300">
                  Účet #{order.order_number}
                </span>
                <span :if={Map.has_key?(@bar_badges, order.id)} class="mt-2 block">
                  <.bar_badge entry={@bar_badges[order.id]} />
                </span>
              </span>

              <span class="pos-account-total mt-2 block w-full pt-2 border-t border-tertiary-200">
                <span class="text-sm font-semibold text-tertiary-700">
                  {format_currency(order.total_amount)}
                </span>
              </span>
            </button>
          </div>
        </div>

        <!-- Empty State -->
        <div
          :if={@orders == []}
          class="rounded-xl border border-secondary-200 bg-white px-4 py-8 text-center"
        >
          <.account_stamp stamp="mug" class="mx-auto mb-3 h-16 w-16" />
          <h2 class="text-lg font-bold text-primary-400 mb-1">
            Zatím tu nejsou žádné otevřené účty
          </h2>
          <p class="text-sm text-primary-400">Nový účet můžete založit tlačítkem výše.</p>
        </div>
      </div>
      <.bar_podium :if={!@service_mode} entries={@leaderboard} />
    </div>

    <!-- Quick Order Modal -->
    <%= if @show_quick_order_modal do %>
      <div class="fixed inset-0 bg-primary-900/50 flex items-center justify-center z-50 p-4">
        <.focus_wrap
          id="pos-quick-order-dialog"
          role="dialog"
          aria-modal="true"
          aria-labelledby="pos-quick-order-title"
          phx-mounted={JS.focus(to: "#pos-account-name")}
          phx-remove={JS.focus(to: "#pos-new-account")}
          phx-window-keydown="hide_quick_order_modal"
          phx-key="escape"
          class="bg-white rounded-2xl shadow-2xl max-w-lg w-full max-h-[90dvh] overflow-y-auto p-6 animate-in fade-in zoom-in duration-200"
        >
          <h3 id="pos-quick-order-title" class="text-3xl font-bold text-primary-500 mb-6">
            Nový účet
          </h3>

          <div class="mb-8">
            <label
              for="pos-account-name"
              class="block text-lg font-semibold text-primary-500 mb-3"
            >
              Název účtu
            </label>
            <input
              type="text"
              id="pos-account-name"
              name="order_name"
              placeholder="Např. Novákovi, pokoj 5 nebo návštěva"
              class="w-full px-4 py-4 text-lg border-2 border-secondary-300 rounded-xl focus:border-tertiary-500 focus:outline-none transition-colors"
              value={@quick_order_name}
              phx-keyup="update_quick_order_name"
              autofocus
            />
            <p class="mt-2 text-sm text-primary-300">
              Zadejte jméno nebo název, podle kterého svůj účet poznáte.
            </p>
          </div>

          <form id="pos-stamp-form" phx-change="select_account_stamp" class="mb-6">
            <.account_stamp_picker
              id="pos-stamp-picker"
              name="account_stamp"
              value={@quick_order_stamp}
            />
          </form>

          <div class="flex gap-4">
            <button
              phx-click="hide_quick_order_modal"
              class="flex-1 px-6 py-4 bg-secondary-200 text-primary-500 rounded-xl hover:bg-secondary-300 transition-colors text-lg font-semibold"
            >
              Zrušit
            </button>
            <button
              phx-click="create_quick_order"
              disabled={String.trim(@quick_order_name) == ""}
              class="flex-1 px-6 py-4 bg-tertiary-500 text-white rounded-xl hover:bg-tertiary-600 transition-all disabled:opacity-50 disabled:cursor-not-allowed text-lg font-semibold"
            >
              Založit účet
            </button>
          </div>
        </.focus_wrap>
      </div>
    <% end %>
  </div>
</Layouts.pos>
