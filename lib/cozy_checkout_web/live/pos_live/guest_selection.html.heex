<Layouts.pos page_title={@page_title}>
  <div class="min-h-screen bg-secondary-50 p-4">
    <header
      id="pos-welcome"
      aria-labelledby="pos-house-name"
      class="relative mb-3 isolate overflow-hidden rounded-xl border border-secondary-200 bg-secondary-50"
    >
      <img
        src={~p"/images/rano-nad-udolim.webp"}
        alt=""
        aria-hidden="true"
        width="1280"
        height="960"
        fetchpriority="high"
        class="pointer-events-none absolute inset-0 h-full w-full object-cover object-[center_60%] opacity-30"
      />
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 bg-linear-to-r from-secondary-50/95 via-secondary-50/80 to-secondary-50/40"
      >
      </div>
      <div class="relative flex min-h-20 flex-wrap items-center justify-between gap-3 px-4 py-3">
        <h1 id="pos-house-name" class="text-xl font-bold text-primary-500 sm:text-2xl">
          Jindřichův dům
        </h1>
        <div class="flex flex-wrap items-center gap-2">
          <button
            phx-click="show_quick_order_modal"
            id="pos-new-account"
            class="inline-flex min-h-11 items-center justify-center gap-2 rounded-lg bg-primary-500 px-3 text-sm font-semibold text-white transition-colors hover:bg-primary-600 active:scale-98"
          >
            <.icon name="hero-plus-circle" class="h-5 w-5" /> Nový účet bez pobytu
          </button>

          <!-- Obsluha Mode Toggle -->
          <div class="flex min-h-11 items-center gap-2 rounded-lg border border-secondary-200 bg-white/95 px-3">
            <span class={[
              "text-sm font-semibold transition-colors duration-200",
              (@service_mode && "text-gray-400") || "text-primary-600"
            ]}>
              Hosté
            </span>
            <button
              aria-label="Režim obsluhy"
              role="switch"
              aria-checked={to_string(@service_mode)}
              phx-click="toggle_service_mode"
              class={[
                "relative inline-flex h-7 w-14 items-center rounded-full transition-colors duration-200 ease-in-out focus:outline-none focus:ring-2 focus:ring-purple-500 focus:ring-offset-2",
                (@service_mode && "bg-purple-600") || "bg-gray-300"
              ]}
            >
              <span class={[
                "inline-block h-5 w-5 transform rounded-full bg-white shadow-lg transition-transform duration-200 ease-in-out",
                (@service_mode && "translate-x-8") || "translate-x-1"
              ]}></span>
            </button>
            <span class={[
              "text-sm font-semibold transition-colors duration-200",
              (@service_mode && "text-purple-600") || "text-gray-400"
            ]}>
              Obsluha
            </span>
          </div>
          <.link
            href={~p"/admin"}
            class="inline-flex min-h-11 items-center gap-2 rounded-lg border border-secondary-200 bg-white/95 px-3 text-sm font-semibold text-primary-500 transition-colors hover:bg-secondary-100"
          >
            <.icon name="hero-lock-closed" class="w-5 h-5" /> Správa
          </.link>
        </div>
      </div>
    </header>

    <!-- Účty bez pobytu Section -->
    <div :if={@standalone_orders != []} class="mb-4">
      <h2 class="text-lg font-bold text-primary-500 mb-2">Účty bez pobytu</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-3">
        <div
          :for={order <- @standalone_orders}
          phx-click="select_order"
          phx-value-order-id={order.id}
          class={[
            "bg-tertiary-50 rounded-xl shadow-lg hover:shadow-2xl transition-all duration-200",
            "p-4 cursor-pointer active:scale-95 border-2 border-tertiary-200 hover:border-tertiary-400",
            "min-h-[120px] flex flex-col justify-between"
          ]}
        >
          <div>
            <div class="flex items-center gap-2">
              <.icon name="hero-shopping-cart" class="w-5 h-5 text-tertiary-600" />
              <span class="px-2 py-0.5 bg-tertiary-200 text-tertiary-800 text-xs font-semibold rounded-full">
                Bez pobytu
              </span>
            </div>
            <h2 class="text-lg font-bold text-primary-500 mb-2 break-words leading-tight">
              {order.name}
            </h2>
            <div class="text-xs text-primary-300">
              Účet #{order.order_number}
            </div>
          </div>

          <div class="mt-2 pt-2 border-t border-tertiary-200">
            <div class="text-sm font-semibold text-tertiary-700">
              {format_currency(order.total_amount)}
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Bookings Section -->
    <h2 :if={@bookings != []} class="text-lg font-bold text-primary-500 mb-2">
      Ubytovaní hosté
    </h2>

    <!-- Bookings Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-3">
      <div
        :for={booking <- @bookings}
        phx-click="select_booking"
        phx-value-booking_id={booking.id}
        class={[
          "bg-white rounded-xl shadow-lg hover:shadow-2xl transition-all duration-200",
          "p-4 cursor-pointer active:scale-95 border-2 border-transparent hover:border-tertiary-500",
          "min-h-[120px] flex flex-col justify-between"
        ]}
      >
        <div>
          <!-- Guest Name -->
          <h2 class="text-lg font-bold text-primary-500 mb-2 break-words leading-tight">
            {booking.guest.name}
          </h2>

          <!-- Room Number -->
          <div :if={booking.room_number} class="flex items-center gap-1.5 mt-1">
            <.icon name="hero-home" class="w-4 h-4 text-primary-300" />
            <span class="text-sm text-primary-400">Pokoj {booking.room_number}</span>
          </div>

          <!-- Check-in Period -->
          <div
            :if={booking.check_in_date}
            class="flex items-center gap-1.5 text-xs text-primary-300"
          >
            <.icon name="hero-calendar" class="w-3.5 h-3.5" />
            <span>
              {Calendar.strftime(booking.check_in_date, "%d. %m.")}
              {if booking.check_out_date,
                do: " - #{Calendar.strftime(booking.check_out_date, "%d. %m.")}",
                else: ""}
            </span>
          </div>
        </div>

        <!-- Open Orders Badge -->
        <div :if={booking.open_orders_count > 0} class="mt-2 pt-2 border-t border-secondary-200">
          <div class="inline-flex items-center gap-1.5 bg-success-light text-success-dark px-2.5 py-1 rounded-full text-xs font-semibold">
            <.icon name="hero-shopping-cart" class="w-3.5 h-3.5" />
            <span>
              {booking.open_orders_count} {cond do
                booking.open_orders_count == 1 -> "otevřený účet"
                booking.open_orders_count in 2..4 -> "otevřené účty"
                true -> "otevřených účtů"
              end}
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- Empty State -->
    <div
      :if={@bookings == []}
      class="rounded-xl border border-secondary-200 bg-white px-4 py-8 text-center"
    >
      <.icon name="hero-calendar-days" class="w-10 h-10 text-secondary-300 mx-auto mb-3" />
      <h2 class="text-lg font-bold text-primary-400 mb-1">
        Zatím tu nejsou žádné aktivní pobyty
      </h2>
      <p class="text-sm text-primary-400">Účet bez pobytu můžete založit tlačítkem výše.</p>
    </div>

    <!-- Quick Order Modal -->
    <%= if @show_quick_order_modal do %>
      <div class="fixed inset-0 bg-primary-900 bg-opacity-50 flex items-center justify-center z-50 p-4">
        <div class="bg-white rounded-2xl shadow-2xl max-w-lg w-full p-8 animate-in fade-in zoom-in duration-200">
          <h3 class="text-3xl font-bold text-primary-500 mb-6">Nový účet bez pobytu</h3>

          <div class="mb-8">
            <label
              for="pos-account-name"
              class="block text-lg font-semibold text-primary-500 mb-3"
            >
              Název účtu
            </label>
            <input
              type="text"
              id="pos-account-name"
              name="order_name"
              placeholder="Např. Novákovi, pokoj 5 nebo návštěva"
              class="w-full px-4 py-4 text-lg border-2 border-secondary-300 rounded-xl focus:border-tertiary-500 focus:outline-none transition-colors"
              value={@quick_order_name}
              phx-keyup="update_quick_order_name"
              autofocus
            />
            <p class="mt-2 text-sm text-primary-300">
              Zadejte jméno nebo název, podle kterého svůj účet poznáte.
            </p>
          </div>

          <div class="flex gap-4">
            <button
              phx-click="hide_quick_order_modal"
              class="flex-1 px-6 py-4 bg-secondary-200 text-primary-500 rounded-xl hover:bg-secondary-300 transition-colors text-lg font-semibold"
            >
              Zrušit
            </button>
            <button
              phx-click="create_quick_order"
              disabled={String.trim(@quick_order_name) == ""}
              class="flex-1 px-6 py-4 bg-tertiary-500 text-white rounded-xl hover:bg-tertiary-600 transition-all disabled:opacity-50 disabled:cursor-not-allowed text-lg font-semibold"
            >
              Založit účet
            </button>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</Layouts.pos>
