<Layouts.app
  food_section={:planner}
  food_context={@food_context}
  flash={@flash}
  show_header={false}
  main_class=""
  content_class=""
>
  <div class="w-full space-y-6">
    <.kitchen_header
      title={"Menu rezervace · #{@booking.guest.name}"}
      subtitle={"#{Calendar.strftime(@booking.check_in_date, "%d.%m.%Y")} – #{if @booking.check_out_date, do: Calendar.strftime(@booking.check_out_date, "%d.%m.%Y"), else: "odjezd nevyplněn"} · #{meal_plan_label(@booking.meal_plan)}"}
      back={
        CozyCheckoutWeb.FoodNavigation.back_path(
          @request_context,
          ~p"/admin/bookings/#{@booking.id}"
        )
      }
      back_label={
        CozyCheckoutWeb.FoodNavigation.back_label(@request_context, "Zpět na detail rezervace")
      }
    />
    <div class="space-y-2">
      <button
        id="booking-menu-toggle-breakfasts"
        type="button"
        phx-click="toggle_breakfasts"
        role="switch"
        aria-checked={to_string(@show_breakfasts)}
        class="text-sm text-tertiary-600 underline"
      >{if @show_breakfasts, do: "Skrýt snídaně", else: "Zobrazit a upravit snídaně"}</button>
      <p :if={not @show_breakfasts} class="text-sm text-primary-400">
        Skryté snídaně zůstávají součástí menu i výpočtu surovin.
      </p>
    </div>
    <section class="rounded-lg bg-white p-6 shadow">
      <h2 class="text-xl font-semibold text-primary-500">Přiřadit variantu</h2>
      <p class="my-3 text-sm text-primary-400">
        Náhled nic neukládá. Použití mění pouze menu této rezervace. Jídelníčky ostatních skupin zůstávají zachované.
      </p>
      <.form
        for={@selection_form}
        id="booking-menu-selection"
        phx-submit="preview"
      >
        <.searchable_picker
          field={@selection_form[:variant_id]}
          options={@variant_options}
          query={@variant_query}
          open={@variant_open}
          required={false}
          label="Menu pobytu"
          placeholder="Hledat menu…"
          search_name="variant_search"
          search_event="search_variants"
          open_event="open_variant_search"
          close_event="close_variant_search"
          select_event="select_variant"
        />
        <div class="mt-4 flex flex-wrap items-center gap-4">
          <.button id="preview-booking-menu" type="submit">Zobrazit náhled</.button>
          <.link
            navigate={CozyCheckoutWeb.FoodNavigation.path(:variants, @food_context)}
            class="text-tertiary-600 underline"
          >Spravovat varianty</.link>
          <.link
            navigate={~p"/admin/bookings/#{@booking.id}/edit"}
            class="text-tertiary-600 underline"
          >Upravit stravování rezervace</.link>
        </div>
      </.form>
    </section>

    <section
      :if={@preview}
      id="booking-menu-preview"
      class="rounded-lg border border-tertiary-200 bg-white p-6 shadow"
    >
      <h2 class="text-xl font-semibold text-primary-500">Náhled · {@preview.variant.name}</h2>
      <ul
        :if={@preview.errors != []}
        id="booking-menu-preview-errors"
        class="my-4 list-inside list-disc text-error"
      >
        <li :for={message <- @preview.errors}>{message}</li>
      </ul>
      <p class="my-3 text-sm text-primary-400">
        Doplňky patří ke stejným porcím. Odlišná menu jiných skupin se vaří souběžně a nepřepisují se.
      </p>
      <div
        id="booking-menu-preview-rows"
        phx-update="stream"
        class="divide-y divide-secondary-200"
      >
        <article
          :for={{id, row} <- @streams.preview_rows}
          id={id}
          class="grid gap-3 py-4 sm:grid-cols-[10rem_1fr_10rem]"
        >
          <div class="font-semibold text-primary-500">
            {Calendar.strftime(row.date, "%d.%m.%Y")}<br />{meal_label(row.meal_type)}
          </div>
          <div>
            <p class="whitespace-pre-line text-primary-500">{row.menu_text}</p>
            <p :if={row.supplements} class="mt-1 whitespace-pre-line text-sm text-primary-400">
              {row.supplements}
            </p>
            <p :if={row.note} class="my-2 text-sm text-primary-400">Poznámka: {row.note}</p>
            <p :if={row.legacy?} class="text-sm text-amber-800">
              Původní položky čekají na kontrolu.
            </p>
            <p :if={row.preserve} class="mt-2 font-semibold text-tertiary-600">
              Ruční úprava bude zachována
            </p>
            <p :if={row.other_groups != []} class="mt-2 text-sm text-warning">
              Odlišné menu souběžných skupin: {Enum.join(row.other_groups, ", ")}
            </p>
          </div>
          <.portion_count id={"preview-portions-#{row.id}"} counts={row.counts} />
        </article>
      </div>
      <.button
        id="apply-booking-menu"
        type="button"
        phx-click="apply"
        disabled={@preview.errors != []}
        phx-disable-with="Používám…"
      >Použít variantu pro tuto rezervaci</.button>
    </section>

    <.freezer_notice
      items={@freezer.unlinked}
      title="Další zásoby k využití"
      context={@food_context}
    />
    <section id="assigned-booking-menu" class="rounded-lg bg-white p-6 shadow">
      <h2 class="text-xl font-semibold text-primary-500">Uložené menu rezervace</h2>
      <.link
        :if={@booking.check_out_date}
        id="booking-menu-shopping"
        navigate={CozyCheckoutWeb.FoodNavigation.path(:shopping, @food_context)}
        class="my-3 inline-block text-tertiary-600 underline"
      >Zobrazit nákup pro tento pobyt</.link>
      <p class="my-2 text-sm text-primary-400">
        Spotřeba a odhady používají aktuální receptury i pro minulá data.
      </p>
      <p :if={is_nil(@menu)} id="booking-menu-unassigned" class="mt-3 text-primary-400">
        Menu ještě není přiřazené. Vyberte variantu a zkontrolujte náhled.
      </p>
      <p :if={@menu} class="mt-3 text-sm text-primary-400">
        Výchozí varianta: {@menu.variant_name}. Změna šablony se sem automaticky nepřenáší.
      </p>
      <p
        :if={@stale_menu}
        id="booking-menu-stale"
        class="my-3 rounded-lg bg-warning-light p-3 font-semibold text-primary-500"
      >
        Termín nebo stravování rezervace se změnilo. Toto menu se v kuchyňském přehledu nepoužívá, dokud znovu nezkontrolujete a nepoužijete variantu.
      </p>
      <div
        id="assigned-booking-menu-items"
        phx-update="stream"
        class="mt-4 divide-y divide-secondary-200"
      >
        <article
          :for={{id, item} <- @streams.menu_items}
          id={id}
          class="grid gap-3 py-4 sm:grid-cols-[10rem_1fr_10rem]"
        >
          <div class="font-semibold text-primary-500">
            {Calendar.strftime(item.date, "%d.%m.%Y")}<br />{meal_label(item.meal_type)}
          </div>
          <div>
            <p class="whitespace-pre-line text-primary-500">
              {CozyCheckout.Meals.MenuRecipes.display(item).main || "Chybí hlavní recept"}
            </p>
            <p
              :if={CozyCheckout.Meals.MenuRecipes.display(item).supplements}
              class="mt-1 whitespace-pre-line text-sm text-primary-400"
            >
              {CozyCheckout.Meals.MenuRecipes.display(item).supplements}
            </p>
            <p :if={item.note} class="my-2 text-sm text-primary-400">Poznámka: {item.note}</p>
            <p
              :if={CozyCheckout.Meals.MenuRecipes.legacy?(item)}
              class="my-2 text-sm text-amber-800"
            >
              Původní text čeká na kontrolu: {CozyCheckout.Meals.MenuPlanning.menu_text(
                item.menu_text,
                item.supplements
              )}
            </p>
            <p
              :if={item.manually_edited}
              id={"manual-menu-item-#{item.id}"}
              class="mt-2 text-sm font-semibold text-tertiary-600"
            >
              Ruční úprava – při použití varianty se zachová
            </p>
            <.freezer_notice
              items={Map.get(@freezer.by_item, item.id, [])}
              context={@food_context}
            />
            <.menu_recipe_links
              id={"item-recipes-#{item.id}"}
              item={item}
              href={
                CozyCheckoutWeb.FoodNavigation.with_context(
                  ~p"/admin/recipes/menu/booking/#{item.id}",
                  Map.put(@food_context, "origin", "booking")
                )
              }
            />
            <div class="mt-3 flex flex-wrap gap-4 text-sm">
              <button
                id={"edit-menu-item-#{item.id}"}
                type="button"
                phx-click="edit_item"
                phx-value-id={item.id}
                class="text-tertiary-600 underline"
              >Upravit jídlo</button>
              <button
                :if={item.manually_edited}
                id={"allow-replacement-#{item.id}"}
                type="button"
                phx-click="allow_replacement"
                phx-value-id={item.id}
                class="text-primary-400 underline"
              >Povolit přepsání při použití varianty</button>
            </div>
          </div>
          <.portion_count id={"assigned-portions-#{item.id}"} counts={item.counts} />
        </article>
      </div>
    </section>
  </div>
  <.modal :if={@edit_item} id="booking-menu-item-modal" show on_cancel={JS.push("close_item")}>
    <h2 class="mb-4 text-xl font-semibold text-primary-500">Upravit jídlo rezervace</h2>
    <.live_component
      module={CozyCheckoutWeb.MealPlannerLive.MenuEditorComponent}
      id={"booking-menu-editor-#{@edit_item.id}"}
      mode={:booking}
      breakfasts_visible={@show_breakfasts}
      record={@edit_item}
      booking_id={@booking_id}
      version={@edit_version}
      return_to={
        CozyCheckoutWeb.FoodNavigation.with_context(
          ~p"/admin/bookings/#{@booking_id}/menu",
          @food_context
        )
      }
    />
  </.modal>
</Layouts.app>
