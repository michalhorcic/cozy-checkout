<!DOCTYPE html>
<html lang="cs" data-theme="noir">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <link rel="icon" type="image/svg+xml" href={~p"/images/cozy-knot.svg"} />
    <link rel="alternate icon" type="image/x-icon" href={~p"/favicon.ico"} />
    <link rel="apple-touch-icon" sizes="180x180" href={~p"/images/apple-touch-icon.png"} />
    <meta name="apple-mobile-web-app-title" content="Jindřichův dům" />
    <.live_title
      default={
        if String.starts_with?(@conn.request_path, "/admin"),
          do: "Administrace",
          else: "Pokladna"
      }
      suffix={
        if String.starts_with?(@conn.request_path, "/admin"),
          do: " · Cozy Checkout",
          else: " · Jindřichův dům"
      }
    >
      {assigns[:page_title]}
    </.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <script>
      (() => {
        // Apply the saved design before paint, even when storage is unavailable.
        let theme = "noir";
        try {
          if (localStorage.getItem("cozy-design") === "light") theme = "light";
        } catch (_) {}
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
  </head>
  <body>
    {@inner_content}
  </body>
</html>
