{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cozy kitchen receipt proposal v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "import_id": {
      "type": "string",
      "format": "uuid"
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "merchant": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ]
        },
        "purchased_on": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "document_number": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ]
        },
        "currency": {
          "const": "CZK"
        },
        "total_paid": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d+(\\.\\d{1,2})?$",
              "maxLength": 40
            },
            {
              "type": "null"
            }
          ]
        },
        "rounding": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?\\d+(\\.\\d{1,2})?$",
              "maxLength": 40
            },
            {
              "type": "null"
            }
          ]
        },
        "shared_discount": {
          "type": "string",
          "pattern": "^\\d+(\\.\\d{1,2})?$",
          "maxLength": 40
        }
      },
      "required": [
        "merchant",
        "purchased_on",
        "document_number",
        "currency",
        "total_paid",
        "rounding"
      ]
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "line_number": {
            "type": "integer",
            "minimum": 1
          },
          "source_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "kind": {
            "enum": [
              "packaged",
              "weighed"
            ]
          },
          "quantity": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d+(\\.\\d+)?$",
                "maxLength": 40
              },
              {
                "type": "null"
              }
            ]
          },
          "unit": {
            "enum": [
              "kg",
              "g",
              "l",
              "ml",
              "ks",
              null
            ]
          },
          "package_count": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d+(\\.\\d+)?$",
                "maxLength": 40
              },
              {
                "type": "null"
              }
            ]
          },
          "package_quantity": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d+(\\.\\d+)?$",
                "maxLength": 40
              },
              {
                "type": "null"
              }
            ]
          },
          "package_unit": {
            "enum": [
              "kg",
              "g",
              "l",
              "ml",
              "ks",
              null
            ]
          },
          "line_total_after_discount": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d+(\\.\\d{1,2})?$",
                "maxLength": 40
              },
              {
                "type": "null"
              }
            ]
          },
          "proposed_ingredient_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "proposed_ingredient_name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1000
              },
              {
                "type": "null"
              }
            ]
          },
          "mapping_reason": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1000
              },
              {
                "type": "null"
              }
            ]
          },
          "warnings": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string",
              "maxLength": 2000
            }
          }
        },
        "required": [
          "line_number",
          "source_name",
          "kind",
          "quantity",
          "unit",
          "line_total_after_discount",
          "proposed_ingredient_id",
          "proposed_ingredient_name",
          "mapping_reason",
          "warnings"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "packaged"
                }
              }
            },
            "then": {
              "required": [
                "package_count",
                "package_quantity",
                "package_unit"
              ]
            },
            "else": {
              "properties": {
                "package_count": {
                  "type": "null"
                },
                "package_quantity": {
                  "type": "null"
                },
                "package_unit": {
                  "type": "null"
                }
              }
            }
          }
        ]
      }
    },
    "warnings": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "maxLength": 2000
      }
    }
  },
  "required": [
    "schema_version",
    "import_id",
    "receipt",
    "items",
    "warnings"
  ]
}
